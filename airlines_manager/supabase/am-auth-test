/**
 * createAmSession()
 * Opens the login page, extracts its CSRF token, submits credentials, and returns an authenticated cookie jar.
 */
async function createAmSession(
  cookieStages: CookieStage[] | null = null
) {



  const jar =

    new CookieJar();





  /* ----------------------------------------------------------

     LOGIN PAGE

  ---------------------------------------------------------- */



  const loginPageResponse =

    await fetch(

      `${AM_BASE}/login`,

      {

        method: "GET",

        redirect: "manual",



        headers: {

          "User-Agent":

            USER_AGENT,



          "Accept":

            "text/html,application/xhtml+xml,application/xml;q=0.9," +

            "image/avif,image/webp,image/apng,*/*;q=0.8",



          "Accept-Language":

            "en-GB,en-US;q=0.9,en;q=0.8",



          "Cache-Control":

            "no-cache",



          "Pragma":

            "no-cache",

        },

      }

    );





  jar.store(

    loginPageResponse

  );

  if (cookieStages) {
    captureCookieStage(
      cookieStages,
      "afterLoginPage",
      jar
    );
  }





  const loginHtml =

    await loginPageResponse.text();





  const csrfMatch =

    loginHtml.match(

      /name=["']_csrf_token["'][^>]*value=["']([^"']+)["']/i

    );





  if (!csrfMatch) {

    throw new Error(

      "Could not find AM login CSRF token"

    );

  }





  const csrfToken =

    csrfMatch[1];





  /* ----------------------------------------------------------

     LOGIN POST

  ---------------------------------------------------------- */



  const form =

    new URLSearchParams();





  form.set(

    "_remember_me",

    "on"

  );



  form.set(

    "_username",

    AM_USERNAME!

  );



  form.set(

    "_password",

    AM_PASSWORD!

  );



  form.set(

    "_csrf_token",

    csrfToken

  );





  const loginResponse =

    await fetch(

      `${AM_BASE}/login_check`,

      {

        method: "POST",

        redirect: "manual",



        headers: {

          "User-Agent":

            USER_AGENT,



          "Accept":

            "text/html,application/xhtml+xml,application/xml;q=0.9," +

            "image/avif,image/webp,image/apng,*/*;q=0.8",



          "Accept-Language":

            "en-GB,en-US;q=0.9,en;q=0.8",



          "Content-Type":

            "application/x-www-form-urlencoded",



          "Origin":

            AM_BASE,



          "Referer":

            `${AM_BASE}/login`,



          "Cache-Control":

            "no-cache",



          "Pragma":

            "no-cache",



          "Cookie":

            jar.header(),

        },



        body:

          form.toString(),

      }

    );





  jar.store(

    loginResponse

  );

  if (cookieStages) {
    captureCookieStage(
      cookieStages,
      "afterLogin",
      jar
    );
  }





  const loginLocation =

    loginResponse.headers.get(

      "location"

    );





  if (

    loginResponse.status !== 302 ||

    !loginLocation ||

    loginLocation === "/login" ||

    loginLocation.includes(

      "/login?"

    )

  ) {

    throw new Error(

      `Airlines Manager authentication failed. ` +

      `Status=${loginResponse.status}, ` +

      `redirect=${loginLocation}`

    );

  }





  return {

    jar,



    loginStatus:

      loginResponse.status,



    loginRedirect:

      loginLocation,

  };

}





/* ============================================================

   AUTHENTICATED AM GET

============================================================ */



/**
 * fetchAmPage()
 * Fetches an authenticated AM page with retry/backoff, redirect and login-form checks.
 */
async function fetchAmPage(

  jar: CookieJar,

  url: string,

  referer: string

) {



  let lastStatus:

    number | null = null;



  let lastError:

    string | null = null;





  for (

    let attempt = 1;

    attempt <= MAX_ATTEMPTS;

    attempt++

  ) {



    try {



      const response =

        await fetch(

          url,

          {

            method: "GET",

            redirect: "manual",



            headers:

              normalHeaders(

                jar,

                referer

              ),

          }

        );





      jar.store(

        response

      );





      lastStatus =

        response.status;





      if (

        response.status === 302

      ) {

        const location =

          response.headers.get(

            "location"

          );





        if (

          location &&

          location.includes(

            "/login"

          )

        ) {

          throw new Error(

            "AM authentication was lost"

          );

        }

      }





      /*

       * Transient statuses we've already seen or

       * should treat as retryable.

       */

      if (

        response.status === 204 ||

        response.status === 429 ||

        response.status >= 500

      ) {



        if (

          attempt <

          MAX_ATTEMPTS

        ) {

          await sleep(

            attempt * 3000

          );



          continue;

        }

      }





      if (

        response.status !== 200

      ) {

        return {

          ok: false,

          status:

            response.status,

          attempts:

            attempt,

          html: "",

          error:

            `HTTP ${response.status}`,

        };

      }





      const html =

        await response.text();





      /*

       * Don't mistake a login page with HTTP 200

       * for an authenticated page.

       */

      if (

        /name=["']_username["']/i

          .test(html) &&

        /name=["']_password["']/i

          .test(html)

      ) {

        throw new Error(

          "AM returned the login form"

        );

      }





      return {

        ok: true,

        status: 200,

        attempts:

          attempt,

        html,

        error: null,

      };



    } catch (error) {



      lastError =

        error instanceof Error

          ? error.message

          : String(error);





      if (

        attempt <

        MAX_ATTEMPTS

      ) {

        await sleep(

          attempt * 3000

        );



        continue;

      }

    }

  }





  return {

    ok: false,

    status:

      lastStatus,

    attempts:

      MAX_ATTEMPTS,

    html: "",

    error:

      lastError ||

      "Unknown fetch error",

  };

}

/* ============================================================

   AUDIT PARSER

============================================================ */



/**
 * parseAuditPage()
 * Parses audit list rows and adjacent current-price rows into route IDs and four-class price records.
 */
function parseAuditPage(
  html: string,
  sourcePage: number,
  hubCode: string
) {



  const rows =

    getRows(html);



  const routes: any[] = [];





  for (

    let i = 0;

    i < rows.length;

    i++

  ) {



    const row =

      rows[i];





    /*

     * Example route row:

     *

     * BKK/SNU - $5,078 $6,753 $11,679 $18,244 ...

     */



    const route =

      canonicalRoute(
        row.text,
        hubCode
      );





    if (!route) {

      continue;

    }





    /*

     * Four ideal/audit prices.

     */



    const moneyMatches =

      Array.from(

        row.text.matchAll(

          /\$\s*([\d\s,]+)/g

        )

      );





    if (

      moneyMatches.length < 4

    ) {

      continue;

    }





    const auditPrices =

      moneyMatches

        .slice(

          0,

          4

        )

        .map(

          match =>

            parseNumber(

              match[1]

            )

        );





    if (

      auditPrices.some(

        value =>

          value === null

      )

    ) {

      continue;

    }





    /*

     * Route ID.

     */



/*
 * Route ID.
 *
 * Audited routes normally contain an /internalaudit/{id} link.
 * Routes displaying "No audit" may not have that link, but AM
 * still provides the route ID as the <tr id="..."> attribute.
 */
    const linkIdMatch =
      row.html.match(
        /\/marketing\/internalaudit\/(\d+)/i
      );

    const rowIdMatch =
      row.html.match(
        /<tr\b[^>]*\bid=["'](\d+)["']/i
      );

    const routeId =
      linkIdMatch
        ? Number(linkIdMatch[1])
        : rowIdMatch
          ? Number(rowIdMatch[1])
          : null;

    if (
      routeId === null ||
      !Number.isFinite(routeId)
    ) {
      continue;
    }




    /*

     * Next row should contain Current price.

     */



    const nextRow =

      rows[i + 1];





    if (!nextRow) {

      continue;

    }





    if (

      !/^Current price\b/i.test(

        nextRow.text

      )

    ) {

      continue;

    }





    const currentMatches =

      Array.from(

        nextRow.text.matchAll(

          /\$\s*([\d\s,]+)/g

        )

      );





    if (

      currentMatches.length < 4

    ) {

      continue;

    }





    const currentPrices =

      currentMatches

        .slice(

          0,

          4

        )

        .map(

          match =>

            parseNumber(

              match[1]

            )

        );





    if (

      currentPrices.some(

        value =>

          value === null

      )

    ) {

      continue;

    }





    routes.push({



      scan_id:

        null,



      route_id:
        routeId,


      route,



      source_page:

        sourcePage,



      audit_economy:

        auditPrices[0],



      audit_business:

        auditPrices[1],



      audit_first:

        auditPrices[2],



      audit_cargo:

        auditPrices[3],



      current_economy:

        currentPrices[0],



      current_business:

        currentPrices[1],



      current_first:

        currentPrices[2],



      current_cargo:

        currentPrices[3],

    });

  }





  return routes;

}





