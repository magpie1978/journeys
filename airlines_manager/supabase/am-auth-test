/**
 * sleep()
 * Waits for a specified number of milliseconds; used to space requests and retry attempts.
 */
function sleep(ms: number) {

  return new Promise(

    resolve =>

      setTimeout(resolve, ms)

  );

}





/**
 * jsonResponse()
 * Serialises an API result as indented JSON with the requested HTTP status and CORS headers.
 */
function jsonResponse(

  body: unknown,

  status = 200

) {

  return new Response(

    JSON.stringify(

      body,

      null,

      2

    ),

    {

      status,

      headers: {

        ...corsHeaders,



        "Content-Type":

          "application/json; charset=utf-8",

      },

    }

  );

}



