   PAGE VALIDATION

============================================================ */



/**
 * expectedRouteCount()
 * Computes the expected route count for a page, using page size and known total where available.
 */
function expectedRouteCount(
  mode: "audit" | "pricing",
  page: number,
  totalPages: number,
  expectedTotalRoutes: number | null
) {
  const normalPageSize =
    mode === "audit"
      ? AUDIT_NORMAL_PAGE_SIZE
      : PRICING_NORMAL_PAGE_SIZE;

  if (page < totalPages) {
    return normalPageSize;
  }

  if (
    page === totalPages &&
    expectedTotalRoutes !== null &&
    expectedTotalRoutes >= 0
  ) {
    const remainder = expectedTotalRoutes % normalPageSize;
    return remainder === 0 && expectedTotalRoutes > 0
      ? normalPageSize
      : remainder;
  }

  return null;
}


/**
 * validateParsedPage()
 * Rejects unexpected parsed page counts; prevents incomplete pages from being marked complete.
 */
function validateParsedPage(
  mode: "audit" | "pricing",
  page: number,
  routes: any[],
  totalPages: number,
  expectedTotalRoutes: number | null
) {
  const expected =
    expectedRouteCount(
      mode,
      page,
      totalPages,
      expectedTotalRoutes
    );

  if (expected !== null) {
    if (routes.length !== expected) {
      return {
        valid: false,
        expected,
        error:
          `${mode} page ${page}: parsed ${routes.length} routes, expected ${expected}`,
      };
    }

    return {
      valid: true,
      expected,
      error: null,
    };
  }

  if (routes.length === 0) {
    return {
      valid: false,
      expected: null,
      error:
        `${mode} page ${page}: parsed zero routes`,
    };
  }

  return {
    valid: true,
    expected: null,
    error: null,
  };
}


/* ============================================================
   HUB DISCOVERY
============================================================ */

/** Type: DiscoveredHub — Hub identity and expected audit/pricing workload discovered from AM. */
type DiscoveredHub = {
  hub_id: number;
  hub_code: string;
  hub_name: string | null;
  audit_routes: number;
  audit_total_pages: number;
  pricing_routes: number | null;
  pricing_total_pages: number;
};

/**
 * extractSelectHtml()
 * Locates a select element by ID in raw HTML for dropdown parsing.
 */
function extractSelectHtml(html: string, id: string) {
  const safe = id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = html.match(
    new RegExp(
      `<select\\b[^>]*\\bid=["']${safe}["'][^>]*>[\\s\\S]*?<\\/select>`,
      "i"
    )
  );
  return match ? match[0] : null;
}

/**
 * parseHubOptions()
 * Reads hub IDs, codes, names and optional audit route counts from the hub dropdown.
 */
function parseHubOptions(
  html: string,
  mode: "audit" | "pricing"
) {
  const select = extractSelectHtml(html, "hubDropdown");
  if (!select) {
    throw new Error(
      `Could not find #hubDropdown on the ${mode} page.`
    );
  }

  const options: any[] = [];
  const optionRegex =
    /<option\b[^>]*value=["']([^"']+)["'][^>]*>([\s\S]*?)<\/option>/gi;

  let match: RegExpExecArray | null;

  while ((match = optionRegex.exec(select)) !== null) {
    const value = decodeEntities(match[1]);
    const text = cleanText(match[2]);

    const airportMatch = value.match(/[?&]airport=(\d+)/i);
    if (!airportMatch) continue;

    const hubId = Number(airportMatch[1]);
    if (!Number.isInteger(hubId) || hubId <= 0) continue;

    const codeMatch = text.match(/^([A-Z0-9]{3})\s*-\s*/i);
    if (!codeMatch) continue;

    const hubCode = codeMatch[1].toUpperCase();

    let routeCount: number | null = null;
    let hubNameText = text;

    if (mode === "audit") {
      const countMatch = text.match(/\((\d+)\)\s*$/);
      if (countMatch) {
        routeCount = Number(countMatch[1]);
        hubNameText = text.replace(/\s*\(\d+\)\s*$/, "");
      }
    }

    const hubName =
      hubNameText
        .replace(/^[A-Z0-9]{3}\s*-\s*/i, "")
        .trim() || null;

    options.push({
      hub_id: hubId,
      hub_code: hubCode,
      hub_name: hubName,
      route_count: routeCount,
      value,
    });
  }

  return options;
}

/**
 * maxPageNumber()
 * Finds the highest pagination page number advertised in HTML links.
 */
function maxPageNumber(html: string) {
  let maxPage = 1;
  for (const match of html.matchAll(/[?&](?:amp;)?page=(\d+)/gi)) {
    const page = Number(match[1]);
    if (Number.isInteger(page) && page > maxPage) {
      maxPage = page;
    }
  }
  return maxPage;
}

/**
 * discoverHubs()
 * Authenticates, reads pricing and audit hub selectors, and determines each hub’s page totals.
 */
async function discoverHubs() {
  const session = await createAmSession();

  const pricingIndex = await fetchAmPage(
    session.jar,
    `${AM_BASE}/marketing/pricing/?airport=0&page=1`,
    `${AM_BASE}/marketing/pricing/`
  );

  if (!pricingIndex.ok) {
    throw new Error(
      pricingIndex.error ||
      `Hub discovery Pricing HTTP ${pricingIndex.status}`
    );
  }

  const auditIndex = await fetchAmPage(
    session.jar,
    `${AM_BASE}/marketing/internalaudit/linelist`,
    `${AM_BASE}/marketing/pricing/`
  );

  if (!auditIndex.ok) {
    throw new Error(
      auditIndex.error ||
      `Hub discovery Audit HTTP ${auditIndex.status}`
    );
  }

  const pricingHubs =
    parseHubOptions(pricingIndex.html, "pricing");

  const auditHubs =
    parseHubOptions(auditIndex.html, "audit");

  if (pricingHubs.length === 0) {
    throw new Error("Price Management returned no hubs.");
  }

  const auditById =
    new Map(
      auditHubs.map(hub => [
        Number(hub.hub_id),
        hub
      ])
    );

  const hubs: DiscoveredHub[] = [];

  for (let i = 0; i < pricingHubs.length; i++) {
    const pricingHub = pricingHubs[i];
    const auditHub = auditById.get(Number(pricingHub.hub_id));

    const pricingPage = await fetchAmPage(
      session.jar,
      `${AM_BASE}/marketing/pricing/?airport=${pricingHub.hub_id}&page=1`,
      `${AM_BASE}/marketing/pricing/`
    );

    if (!pricingPage.ok) {
      throw new Error(
        `Could not inspect Pricing for ${pricingHub.hub_code}: ` +
        (pricingPage.error || `HTTP ${pricingPage.status}`)
      );
    }

    const firstPricingRoutes =
      parsePricingPage(
        pricingPage.html,
        1,
        pricingHub.hub_code
      );

    const pricingTotalPages =
      firstPricingRoutes.length === 0
        ? 0
        : maxPageNumber(pricingPage.html);

    const auditRoutes =
      auditHub?.route_count ?? 0;

    const auditTotalPages =
      auditRoutes > 0
        ? Math.ceil(auditRoutes / AUDIT_NORMAL_PAGE_SIZE)
        : 0;

    hubs.push({
      hub_id: Number(pricingHub.hub_id),
      hub_code: pricingHub.hub_code,
      hub_name: pricingHub.hub_name,
      audit_routes: auditRoutes,
      audit_total_pages: auditTotalPages,
      pricing_routes: null,
      pricing_total_pages: pricingTotalPages,
    });

    if (i < pricingHubs.length - 1) {
      await sleep(REQUEST_DELAY_MS);
    }
  }

  return {
    authentication: {
      loginStatus: session.loginStatus,
      loginRedirect: session.loginRedirect,
    },
    hubs,
  };
}


