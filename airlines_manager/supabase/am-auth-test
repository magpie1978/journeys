   DATABASE / SCAN STATE
============================================================ */

/**
 * createScan()
 * Creates a multi-hub scan and associated hub-state records in Supabase.
 */
async function createScan() {
  const discovery = await discoverHubs();

  if (discovery.hubs.length === 0) {
    throw new Error("No hubs were discovered.");
  }

  const primaryHub = discovery.hubs[0];

  const auditTotalPages =
    discovery.hubs.reduce(
      (sum, hub) => sum + hub.audit_total_pages,
      0
    );

  const pricingTotalPages =
    discovery.hubs.reduce(
      (sum, hub) => sum + hub.pricing_total_pages,
      0
    );

  const {
    data,
    error,
  } =
    await supabase
      .from("am_scans")
      .insert({
        /*
         * Retained only for backward compatibility with the existing
         * am_scans schema. The actual scan is multi-hub.
         */
        hub_id: primaryHub.hub_id,
        hub_code: primaryHub.hub_code,
        status: "running",
        audit_total_pages: auditTotalPages,
        pricing_total_pages: pricingTotalPages,
        hubs_discovered: discovery.hubs.length,
        hubs_complete: 0,
      })
      .select()
      .single();

  if (error) {
    throw new Error(
      `Could not create scan: ${error.message}`
    );
  }

  const now = new Date().toISOString();

  const hubRows =
    discovery.hubs.map(hub => ({
      scan_id: data.id,
      hub_id: hub.hub_id,
      hub_code: hub.hub_code,
      hub_name: hub.hub_name,
      status:
        hub.audit_total_pages === 0 &&
        hub.pricing_total_pages === 0
          ? "zero_routes"
          : "pending",
      audit_total_pages: hub.audit_total_pages,
      pricing_total_pages: hub.pricing_total_pages,
      audit_pages_complete: 0,
      pricing_pages_complete: 0,
      audit_routes: 0,
      pricing_routes: 0,
      started_at: null,
      completed_at:
        hub.audit_total_pages === 0 &&
        hub.pricing_total_pages === 0
          ? now
          : null,
      updated_at: now,
    }));

  const { error: hubError } =
    await supabase
      .from("am_scan_hubs")
      .upsert(
        hubRows,
        {
          onConflict: "scan_id,hub_id",
        }
      );

  if (hubError) {
    await supabase
      .from("am_scans")
      .delete()
      .eq("id", data.id);

    throw new Error(
      `Could not save discovered hubs: ${hubError.message}`
    );
  }

  return {
    ...data,
    hubs: discovery.hubs,
    authentication: discovery.authentication,
  };
}


