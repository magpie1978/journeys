/**
 * getSessionDiagnostic()
 * Collects safe session/authentication diagnostics for troubleshooting.
 */
async function getSessionDiagnostic(
  scanId: string,
  hubId: number,
  routeId: number
) {
  // Validate that this route belongs to the requested completed scan.
  const state = await getPriceStatus(
    scanId,
    hubId,
    routeId
  );

  if (!state.route) {
    return {
      ok: false,
      reason: "route_not_found",
      routeId,
    };
  }

  const stages: CookieStage[] = [];
  const session = await createAmSession(stages);

  const pricingUrl =
    `${AM_BASE}/marketing/pricing/${routeId}`;

  const page = await fetchAmPage(
    session.jar,
    pricingUrl,
`${AM_BASE}/marketing/pricing/?airport=${hubId}&page=1`
  );

  // fetchAmPage stores any Set-Cookie headers before returning.
  captureCookieStage(
    stages,
    "afterPricingPage",
    session.jar
  );

  return {
    ok: page.ok,
    action: "session-diagnostic",
    scanId,
    routeId,
