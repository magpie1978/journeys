/**
 * decodeEntities()
 * Normalises HTML entity representations before extracting readable page text.
 */
function decodeEntities(

  value: string

) {

  return value

    .replace(/ /gi, " ")

    .replace(/ /gi, " ")

    .replace(/ /gi, " ")

    .replace(/&/gi, "&")

    .replace(/"/gi, '"')

    .replace(/"/gi, '"')

    .replace(/'/gi, "'")

    .replace(/'/gi, "'")

    .replace(/</gi, "<")

    .replace(/>/gi, ">");

}





/**
 * cleanText()
 * Removes script/style blocks and HTML tags, decodes entities, and collapses whitespace.
 */
function cleanText(

  value: string

) {

  return decodeEntities(

    value

      .replace(

        new RegExp("<script\\b[^>]*>[\\s\\S]*?</script>", "gi"),

        " "

      )

      .replace(

        new RegExp("<style\\b[^>]*>[\\s\\S]*?</style>", "gi"),

        " "

      )

      .replace(

        /<[^>]+>/g,

        " "

      )

  )

    .replace(/\u00a0/g, " ")

    .replace(/\s+/g, " ")

    .trim();

}





/** Type: HtmlRow — Representation of an HTML table row with raw markup and cleaned text. */
type HtmlRow = {

  html: string;

  text: string;

};





/**
 * getRows()
 * Extracts table-row HTML and corresponding cleaned text for downstream parsers.
 */
function getRows(

  html: string

) {

  const rows: HtmlRow[] = [];



  const regex =

    new RegExp("<tr\\b[^>]*>([\\s\\S]*?)</tr>", "gi");



  let match:

    RegExpExecArray | null;





  while (

    (match = regex.exec(html)) !== null

  ) {

    rows.push({

      html:

        match[0],



      text:

        cleanText(

          match[1]

        ),

    });

  }





  return rows;

}





/**
 * parseNumber()
 * Converts formatted numeric text into a finite number, or null when unparseable.
 */
function parseNumber(

  value:

    | string

    | null

    | undefined

) {

  if (

    value === null ||

    value === undefined

  ) {

    return null;

  }





  const cleaned =

    value

      .replace(

        /[\s,\u00a0]/g,

        ""

      )

      .replace(

        /[^\d.-]/g,

        ""

      );





  if (

    cleaned === "" ||

    cleaned === "-" ||

    cleaned === "."

  ) {

    return null;

  }





  const result =

    Number(cleaned);





  return Number.isFinite(result)

    ? result

    : null;

}





/*

 * Extract a route anywhere in a row.

 *

 * Examples:

 *

 * BKK / KAN

 * BKK/KAN

 * KAN / BKK

 *

 * For this scanner BKK is canonicalised first.

 */

/**
 * canonicalRoute()
 * Recognises an airport-pair string and puts the selected hub first where possible.
 */
function canonicalRoute(
  value: string,
  hubCode: string
) {
  const match =
    value
      .toUpperCase()
      .match(
        /\b([A-Z0-9]{3})\s*\/\s*([A-Z0-9]{3})\b/
      );

  if (!match) {
    return null;
  }

  const a = match[1];
  const b = match[2];
  const hub = hubCode.toUpperCase();

  if (b === hub) {
    return `${hub}/${a}`;
  }

  if (a === hub) {
    return `${hub}/${b}`;
  }

  /*
   * Keep the source order if AM presents a route that does not contain
   * the expected hub code. Validation can then expose the mismatch
   * rather than silently rewriting it.
   */
  return `${a}/${b}`;
}


