/**
 * getScan()
 * Loads the main scan record by scan ID.
 */
async function getScan(scanId: string) {
  const { data, error } =
    await supabase
      .from("am_scans")
      .select("*")
      .eq("id", scanId)
      .single();

  if (error) {
    throw new Error(
      `Could not load scan: ${error.message}`
    );
  }

  return data;
}


/**
 * getScanHubs()
 * Loads hub progress records for a scan in hub-code order.
 */
async function getScanHubs(scanId: string) {
  const { data, error } =
    await supabase
      .from("am_scan_hubs")
      .select("*")
      .eq("scan_id", scanId)
      .order("hub_code", { ascending: true });

  if (error) {
    throw new Error(
      `Could not load scan hubs: ${error.message}`
    );
  }

  return data || [];
}


/* ============================================================
   GET LATEST COMPLETED SCAN
============================================================ */

/**
 * getLatestCompletedScan()
 * Finds the most recently completed scan, if one exists.
 */
async function getLatestCompletedScan() {
  const { data, error } =
    await supabase
      .from("am_scans")
      .select("*")
      .eq("status", "complete")
      .not("completed_at", "is", null)
      .order("completed_at", { ascending: false })
      .limit(1)
      .maybeSingle();

  if (error) {
    throw new Error(
      `Could not load latest completed scan: ${error.message}`
    );
  }

  return data;
}


