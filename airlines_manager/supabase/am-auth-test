/**
 * fetchAllRows()
 * Retrieves multiple pages of database results to avoid a single-response row limit.
 */
async function fetchAllRows(

  table: string,

  select: string,

  scanId: string,

  orderColumn = "route_id"

) {



  const PAGE_SIZE = 1000;



  const rows: any[] = [];



  let from = 0;





  while (true) {



    const to =

      from +

      PAGE_SIZE -

      1;





    const {

      data,

      error,

    } =

      await supabase

        .from(table)

        .select(select)

        .eq(

          "scan_id",

          scanId

        )

        .order(

          orderColumn,

          {

            ascending: true,

          }

        )

        .range(

          from,

          to

        );





    if (error) {

      throw new Error(

        `Failed to read ${table}: ${error.message}`

      );

    }





    const batch =

      data || [];





    rows.push(

      ...batch

    );





    if (

      batch.length <

      PAGE_SIZE

    ) {

      break;

    }





    from +=

      PAGE_SIZE;

  }





  return rows;

}





