      loginStatus: session.loginStatus,
      loginRedirect: session.loginRedirect,
    },
    pricingPage: {
      ok: page.ok,
      httpStatus: page.status,
      attempts: page.attempts,
      error: page.error,
    },
    cookieStages: safeCookieStageReport(stages),
    note:
      "Cookie values are intentionally suppressed. Only names and added/changed/removed state are returned.",
  };
}



/**
 * shortSha256()
 * Produces a shortened SHA-256 fingerprint for comparing sensitive strings without revealing them.
 */
async function shortSha256(value: string | null | undefined) {
  if (!value) return null;
  const bytes = new TextEncoder().encode(value);
  const digest = await crypto.subtle.digest("SHA-256", bytes);
  return Array.from(new Uint8Array(digest))
    .slice(0, 8)
    .map(byte => byte.toString(16).padStart(2, "0"))
    .join("");
}

/**
 * pricingFormOpeningTag()
 * Finds the opening pricing-form tag for diagnostic inspection.
 */
function pricingFormOpeningTag(html: string) {
  const forms = html.match(/<form\b[\s\S]*?<\/form>/gi) || [];
  const form = forms.find(formHtml => /id=["']line_priceEco["']/i.test(formHtml)) || null;
  if (!form) return null;
  const openingTag = form.match(/<form\b[^>]*>/i)?.[0] || "";
  return {
    html: form,
    action: attr(openingTag, "action"),
    method: (attr(openingTag, "method") || "GET").toUpperCase(),
    enctype: attr(openingTag, "enctype") || "application/x-www-form-urlencoded",
  };
}

/**
 * pricingCsrfToken()
 * Extracts a pricing-form CSRF token from HTML.
 */
function pricingCsrfToken(html: string) {
  const info = pricingFormOpeningTag(html);
  if (!info) return null;
  for (const match of info.html.matchAll(/<input\b[^>]*>/gi)) {
    const tag = match[0];
    if (attr(tag, "name") === "line[_token]") {
      return attr(tag, "value") || "";
    }
  }
  return null;
}

/**
 * getSessionCsrfDiagnostic()
 * Compares session and CSRF state across authenticated page requests.
 */
async function getSessionCsrfDiagnostic(
  scanId: string,
  hubId: number,
  routeId: number
) {
  const state = await getPriceStatus(
    scanId,
    hubId,
    routeId
  );
    if (!state.route) {
    return { ok:false, action:"session-csrf-diagnostic", reason:"route_not_found", routeId, readOnly:true };
  }
  if (!state.amendable) {
    return { ok:false, action:"session-csrf-diagnostic", reason:"route_not_amendable", routeId, route:state.route.route, readOnly:true };
  }

  const stages: CookieStage[] = [];
  const session = await createAmSession(stages);
  const url = `${AM_BASE}/marketing/pricing/${routeId}`;
  const referer = `${AM_BASE}/marketing/pricing/?airport=${Number(state.route.hub_id)}&page=1`;

  const first = await fetchAmPage(session.jar, url, referer);
  captureCookieStage(stages, "afterPricingGet1", session.jar);
  if (!first.ok) {
    return {
      ok:false, action:"session-csrf-diagnostic", reason:"pricing_get_1_failed",
      scanId, routeId, route:state.route.route, readOnly:true,
      httpStatus:first.status, cookieStages:safeCookieStageReport(stages)
    };
  }

  const token1 = pricingCsrfToken(first.html);
  const form1 = pricingFormOpeningTag(first.html);
  const php1 = session.jar.cookies.get("PHPSESSID") || null;
  const remember1 = session.jar.cookies.get("REMEMBERME") || null;

  const second = await fetchAmPage(session.jar, url, url);
  captureCookieStage(stages, "afterPricingGet2", session.jar);
  if (!second.ok) {
    return {
      ok:false, action:"session-csrf-diagnostic", reason:"pricing_get_2_failed",
      scanId, routeId, route:state.route.route, readOnly:true,
      httpStatus:second.status, cookieStages:safeCookieStageReport(stages)
    };
  }

  const token2 = pricingCsrfToken(second.html);
  const form2 = pricingFormOpeningTag(second.html);
  const php2 = session.jar.cookies.get("PHPSESSID") || null;
  const remember2 = session.jar.cookies.get("REMEMBERME") || null;

  const r:any = state.route;
  const target = {
    eco:Number(r.eco_target_price), bus:Number(r.bus_target_price),
    first:Number(r.first_target_price), cargo:Number(r.cargo_target_price)
  };
  const encodedForm = pricingForm(second.html, target);
  const encodedBody = encodedForm.toString();
  const entries = Array.from(encodedForm.entries());
  const encodedToken = encodedForm.get("line[_token]");
  const roundTrip = new URLSearchParams(encodedBody).get("line[_token]");

  return {
    ok:true,
    action:"session-csrf-diagnostic",
    scanId,
    routeId,
    route:state.route.route,
    readOnly:true,
    pricingGets:{
      first:{httpStatus:first.status, attempts:first.attempts},
      second:{httpStatus:second.status, attempts:second.attempts}
    },
    csrf:{
      first:{present:token1 !== null, length:token1?.length ?? 0, fingerprint:await shortSha256(token1)},
      second:{present:token2 !== null, length:token2?.length ?? 0, fingerprint:await shortSha256(token2)},
      sameAcrossGets:token1 !== null && token2 !== null && token1 === token2,
      encodedTokenMatchesExtracted:token2 !== null && encodedToken === token2,
      roundTripTokenMatchesExtracted:token2 !== null && roundTrip === token2
    },
    sessionCookies:{
      phpSession:{firstFingerprint:await shortSha256(php1), secondFingerprint:await shortSha256(php2), sameAcrossGets:Boolean(php1 && php2 && php1 === php2)},
      rememberMe:{firstFingerprint:await shortSha256(remember1), secondFingerprint:await shortSha256(remember2), sameAcrossGets:Boolean(remember1 && remember2 && remember1 === remember2)}
    },
    form:{
      first:{action:form1?.action || null, method:form1?.method || null, enctype:form1?.enctype || null},
      second:{action:form2?.action || null, method:form2?.method || null, enctype:form2?.enctype || null},
      sameAction:Boolean(form1 && form2 && form1.action === form2.action),
      sameMethod:Boolean(form1 && form2 && form1.method === form2.method),
      encodedBodyLength:encodedBody.length,
      fieldOrder:entries.map(([name]) => name),
      fieldCount:entries.length
    },
    cookieStages:safeCookieStageReport(stages),
    note:"Read-only diagnostic. Token and cookie values are never returned; only lengths, short SHA-256 fingerprints, equality checks, and form structure are exposed."
  };
}


/**
 * recordBrowserSuccess()
 * Records and verifies a browser-originated pricing success in the update log.
 */
async function recordBrowserSuccess(
  scanId: string,
  hubId: number,
  routeId: number,
  suppliedHubCode: string | null = null
) {
  const state =
    await getPriceStatus(
      scanId,
      hubId,
      routeId
    );

  if (!state.route) {
    throw new Error(
      "Route is not present in this optimiser scan."
    );
  }

  const r: any =
    state.route;

  /*
   * The stored optimiser row is authoritative.
   * Ensure the requested hub matches it.
   */
  const storedHubId =
    Number(r.hub_id);

  if (
    !Number.isInteger(storedHubId) ||
    storedHubId <= 0 ||
    storedHubId !== hubId
  ) {
    throw new Error(
      "The supplied hub does not match the optimiser route."
    );
  }

  const storedHubCode =
    String(
      r.hub_code || ""
    )
      .trim()
      .toUpperCase();

  const incomingHubCode =
    suppliedHubCode
      ? String(suppliedHubCode)
          .trim()
          .toUpperCase()
      : null;

  /*
   * hubCode is useful for diagnostics/history, but hubId is
   * the actual identity. If a hubCode was supplied by the
   * browser, make sure it agrees with the stored route.
   */
  if (
    incomingHubCode &&
    storedHubCode &&
    incomingHubCode !== storedHubCode
  ) {
    throw new Error(
      "The supplied hubCode does not match the optimiser route."
    );
  }

  if (!state.amendable) {
    return {
      ok: false,
      recorded: false,
      reason: "route_locked",
      message:
        "This route is not amendable.",
      hubId,
      hubCode:
        storedHubCode || null,
      routeId
    };
  }

  /*
   * Idempotency:
   *
   * If this exact hub/route has already been recorded as
   * successful within the active 24-hour window, return the
   * existing lock rather than inserting another update.
   */
  if (state.priceLock.locked) {
    return {
      ok: true,
      recorded: false,
      alreadyRecorded: true,
      hubId,
      hubCode:
        storedHubCode || null,
      routeId,
      priceLock:
        state.priceLock
    };
  }

  const old = {
    eco:
      Number(
        r.eco_current_price
      ),

    bus:
      Number(
        r.bus_current_price
      ),

    first:
      Number(
        r.first_current_price
      ),

    cargo:
      Number(
        r.cargo_current_price
      )
  };

  const target = {
    eco:
      Number(
        r.eco_target_price
      ),

    bus:
      Number(
        r.bus_target_price
      ),

    first:
      Number(
        r.first_target_price
      ),

    cargo:
      Number(
        r.cargo_target_price
      )
  };

  if (
    [
      ...Object.values(old),
      ...Object.values(target)
    ].some(
      value =>
        !Number.isFinite(value)
    )
  ) {
    throw new Error(
      "Stored current/target prices are incomplete."
    );
  }

  /*
   * Read-only verification against Airlines Manager.
   *
   * This action NEVER posts a price change to AM.
   */
  const { jar } =
    await createAmSession();

  const url =
    `${AM_BASE}/marketing/pricing/${routeId}`;

  const page =
    await fetchAmPage(
      jar,
      url,
      `${AM_BASE}/marketing/pricing/?airport=${hubId}&page=1`
    );

  if (!page.ok) {
    throw new Error(
      page.error ||
      `Pricing page HTTP ${page.status}`
    );
  }

  const live =
    livePrices(
      page.html
    );

  if (!live) {
    throw new Error(
      "Could not parse live Airlines Manager prices."
    );
  }

  const pricesMatchTarget =
    live.eco === target.eco &&
    live.bus === target.bus &&
    live.first === target.first &&
    live.cargo === target.cargo;

  const locked =
    amPageLooksLocked(
      page.html
    );

  /*
   * We only record success when BOTH conditions are true:
   *
   * 1. AM now shows exactly the stored target prices.
   * 2. AM shows the genuine post-change price lock.
   *
   * Anything else remains unverified and must not create a
   * successful history row.
   */
  if (
    !pricesMatchTarget ||
    !locked
  ) {
    return {
      ok: false,
      recorded: false,
      reason:
        "browser_update_not_verified",
      message:
        "The browser update could not be conclusively verified from Airlines Manager.",
      hubId,
      hubCode:
        storedHubCode || null,
      routeId,
      livePrices:
        live,
      targetPrices:
        target,
      amPageLooksLocked:
        locked
    };
  }

  const now =
    new Date().toISOString();

  /*
   * Permanent successful-update history.
   *
   * hub_id + route_id is the route identity.
   */
  const updateId =
    await logUpdate({
      scan_id:
        scanId,

      hub_id:
        hubId,

      hub_code:
        storedHubCode || null,

      route_id:
        routeId,

      route:
        r.route,

      eco_old:
        old.eco,

      eco_new:
        target.eco,

      bus_old:
        old.bus,

      bus_new:
        target.bus,

      first_old:
        old.first,

      first_new:
        target.first,

      cargo_old:
        old.cargo,

      cargo_new:
        target.cargo,

      status:
        "success",

      http_status:
        200,

      response_message:
        "Verified after native Chrome/Tampermonkey form submission.",

      attempted_at:
        now,

      updated_at:
        now
    });

  return {
    ok: true,
    recorded: true,
    hubId,
    hubCode:
      storedHubCode || null,
    routeId,
    updateId,
    livePrices:
      live,

    priceLock: {
      ...priceLock(now),
      source:
        "am_price_updates",
      updateId
    }
  };
}

/* ============================================================
   PLANNING DATA SCANNER

   READS Airlines Manager planning data and UPSERTS:

   public.am_planning_routes
   public.am_aircraft_types

   Airlines Manager access is READ ONLY.
   No schedules, aircraft, routes or other AM data are changed.

   Supabase behaviour is deliberately conservative:
   - UPSERT only
   - no deletions
   - no pruning of old rows
============================================================ */

/** Type: PlanningHub — Normalised hub record for planning extraction. */
type PlanningHub = {
  planningId: number;
  hubAirportId: number;
  hubCode: string;
  frozen: boolean;
};


/** Type: PlanningAircraftType — Normalised aircraft-type record for planning extraction. */
type PlanningAircraftType = {
  aircraft_type: string;
  speed_kmh: number;
  range_km: number;
  aircraft_category: number;
  updated_at: string;
};

/** Type: PlanningRouteDuration — Normalised aircraft/route duration record. */
type PlanningRouteDuration = {
  hub_id: number;
  line_id: number;
  aircraft_type: string;
  duration_seconds: number;
  updated_at: string;
};

/* ------------------------------------------------------------
   Extract the hub code from the Planning HTML.

   The button itself gives us:

       id="airport_49"
       data-hubId="16017461"

   The visible button content contains the airport code.
------------------------------------------------------------ */

/**
 * extractPlanningHubCode()
 * Derives a hub airport code from planning-page data.
 */
function extractPlanningHubCode(
  tag: string,
  nearbyHtml: string
) {

  /*
   * First try useful attributes on the button itself.
   */

  const candidates = [
    tag.match(
      /\bdata-airport-code=["']([A-Z0-9]{3})["']/i
    )?.[1],

    tag.match(
      /\bdata-code=["']([A-Z0-9]{3})["']/i
    )?.[1],

    tag.match(
      /\btitle=["'][^"']*\b([A-Z0-9]{3})\b[^"']*["']/i
    )?.[1]
  ]
    .filter(Boolean)
    .map(
      value =>
        String(value).toUpperCase()
    );


  if (candidates.length > 0) {
    return candidates[0];
  }


  /*
   * Then inspect a small amount of HTML around the button.
   */

  const text =
    cleanText(
      nearbyHtml
    )
      .toUpperCase();


  const airportMatch =
    text.match(
      /\b([A-Z0-9]{3})\b/
    );


  return airportMatch
    ? airportMatch[1]
    : null;
}


/* ------------------------------------------------------------
   Extract all Planning hub buttons.

   Important distinction:

       hubAirportId = airport ID, e.g. 49
       planningId   = data-hubId, e.g. 16017461
------------------------------------------------------------ */

/**
 * extractPlanningHubs()
 * Discovers hubs represented in the planning dataset.
 */
function extractPlanningHubs(
  html: string
) {

  const hubs:
    PlanningHub[] = [];


  const regex =
    /<[^>]*class=["'][^"']*\bplanninghubBtn\b[^"']*["'][^>]*>/gi;


  for (
    const match of
    html.matchAll(regex)
  ) {

    const tag =
      match[0];


    const planningIdMatch =
      tag.match(
        /\bdata-hubId=["'](\d+)["']/i
      );


    const airportIdMatch =
      tag.match(
        /\bid=["']airport_(\d+)["']/i
      );


    if (
      !planningIdMatch ||
      !airportIdMatch
    ) {
      continue;
    }


    const planningId =
      Number(
        planningIdMatch[1]
      );


    const hubAirportId =
      Number(
        airportIdMatch[1]
      );


    if (
      !Number.isInteger(planningId) ||
      planningId <= 0 ||
      !Number.isInteger(hubAirportId) ||
      hubAirportId <= 0
    ) {
      continue;
    }


    /*
     * Capture some HTML after the opening tag so that the
     * visible airport code can be inspected.
     */

    const start =
      match.index ?? 0;


    const nearbyHtml =
      html.slice(
        start,
        Math.min(
          html.length,
          start + 1000
        )
      );


    const hubCode =
      extractPlanningHubCode(
        tag,
        nearbyHtml
      );


    if (!hubCode) {
      throw new Error(
        `Could not determine airport code for Planning hub airport ID ${hubAirportId}`
      );
    }


    hubs.push({

      planningId,

      hubAirportId,

      hubCode,

      frozen:
        /\bfrozenhub\b/i.test(
          tag
        )

    });
  }


  /*
   * Defensive duplicate detection.
   */

  const planningIds =
    new Set<number>();

  const airportIds =
    new Set<number>();


  for (
    const hub of
    hubs
  ) {

    if (
      planningIds.has(
        hub.planningId
      )
    ) {
      throw new Error(
        `Duplicate Planning ID ${hub.planningId}`
      );
    }


    if (
      airportIds.has(
        hub.hubAirportId
      )
    ) {
      throw new Error(
        `Duplicate Planning airport ID ${hub.hubAirportId}`
      );
    }


    planningIds.add(
      hub.planningId
    );

    airportIds.add(
      hub.hubAirportId
    );
  }


  return hubs;
}


/* ------------------------------------------------------------
   Authenticated Planning JSON fetch.

   Uses the existing authenticated GET helper, so cookie and
   retry behaviour remains consistent with the existing scanner.
------------------------------------------------------------ */

/**
 * fetchPlanningDataset()
 * Fetches authenticated planning data and checks the response before parsing.
 */
async function fetchPlanningDataset(
  jar: CookieJar,
  planningId: number
) {

  const url =
    `${AM_BASE}/network/planning/load/${planningId}`;


  /*
   * Diagnostic fetch for the Planning JSON endpoint.
   *
   * Unlike fetchAmPage(), we deliberately inspect a 302 here
   * rather than following it or treating it as a generic error.
   */

  const response =
    await fetch(
      url,
      {
        method: "GET",
        redirect: "manual",

        headers: {
          ...normalHeaders(
            jar,
            `${AM_BASE}/network/planning`
          ),

          /*
           * This endpoint is requested by AM's JavaScript as JSON,
           * rather than as a normal document navigation.
           */
          "Accept":
            "application/json, text/javascript, */*; q=0.01",

          "X-Requested-With":
            "XMLHttpRequest"
        }
      }
    );


  /*
   * Preserve any cookies AM sends back.
   */

  jar.store(
    response
  );


  if (
    response.status === 302
  ) {

    const location =
      response.headers.get(
        "location"
      );


    throw new Error(
      `Planning dataset ${planningId} returned HTTP 302` +
      (
        location
          ? ` -> ${location}`
          : " with no Location header"
      )
    );
  }


  if (
    response.status !== 200
  ) {

    throw new Error(
      `Planning dataset ${planningId} returned HTTP ${response.status}`
    );
  }


  const text =
    await response.text();


  /*
   * Protect against an authentication failure masquerading
   * as a successful HTML response.
   */

  if (
    /name=["']_username["']/i.test(
      text
    ) &&
    /name=["']_password["']/i.test(
      text
    )
  ) {

    throw new Error(
      `Planning dataset ${planningId} returned the AM login form`
    );
  }


  let data: any;


  try {

    data =
      JSON.parse(
        text
      );

  } catch {

    throw new Error(
      `Planning dataset ${planningId} returned HTTP 200 but was not valid JSON`
    );
  }


  if (
    !data ||
    typeof data !== "object"
  ) {

    throw new Error(
      `Planning dataset ${planningId} returned an invalid JSON object`
    );
  }


  if (
    !Array.isArray(
      data.lineDataArray
    )
  ) {

    throw new Error(
      `Planning dataset ${planningId} has no lineDataArray`
    );
  }


  if (
    !Array.isArray(
      data.aircraftDataArray
    )
  ) {

    throw new Error(
      `Planning dataset ${planningId} has no aircraftDataArray`
    );
  }


  return {

    data,

    httpStatus:
      response.status,

    attempts:
      1

  };
}

/* ------------------------------------------------------------
   Convert AM route JSON into am_planning_routes rows.
------------------------------------------------------------ */

/**
 * buildPlanningRouteRows()
 * Transforms planning route data into rows suitable for Supabase storage.
 */
function buildPlanningRouteRows(
  hub: PlanningHub,
  data: any,
  now: string
) {

  const rows: any[] =
    [];


  for (
    const route of
    data.lineDataArray
  ) {

    if (
      !route ||
      typeof route !== "object"
    ) {
      continue;
    }


    const lineId =
      Number(
        route.id
      );


    const distance =
      Number(
        route.distance
      );


    const category =
      Number(
        route.category
      );


    const airportOneId =
      route.airportOneId === null ||
      route.airportOneId === undefined
        ? null
        : Number(
            route.airportOneId
          );


    const airportTwoId =
      route.airportTwoId === null ||
      route.airportTwoId === undefined
        ? null
        : Number(
            route.airportTwoId
          );


    if (
      !Number.isInteger(lineId) ||
      lineId <= 0
    ) {

      throw new Error(
        `${hub.hubCode}: Planning route has invalid line ID`
      );
    }


    if (
      !Number.isFinite(distance) ||
      distance <= 0
    ) {

      throw new Error(
        `${hub.hubCode}: line ${lineId} has invalid distance`
      );
    }


    if (
      !Number.isInteger(category) ||
      category <= 0
    ) {

      throw new Error(
        `${hub.hubCode}: line ${lineId} has invalid route category`
      );
    }


    /*
     * AM names Planning routes in the form:
     *
     *     BKK / ATL
     */

    const name =
      String(
        route.name || ""
      )
        .toUpperCase()
        .trim();


    const routeMatch =
      name.match(
        /\b([A-Z0-9]{3})\s*\/\s*([A-Z0-9]{3})\b/
      );


    if (!routeMatch) {

      throw new Error(
        `${hub.hubCode}: could not parse route name for line ${lineId}: ${name}`
      );
    }


    const first =
      routeMatch[1];

    const second =
      routeMatch[2];


    let destinationCode:
      string;


    if (
      first === hub.hubCode
    ) {

      destinationCode =
        second;

    } else if (
      second === hub.hubCode
    ) {

      destinationCode =
        first;

    } else {

      throw new Error(
        `${hub.hubCode}: line ${lineId} (${name}) does not contain the expected hub`
      );
    }


    rows.push({

      hub_id:
        hub.hubAirportId,

      hub_code:
        hub.hubCode,

      line_id:
        lineId,

      destination_code:
        destinationCode,

      distance_km:
        Math.round(
          distance
        ),

      route_category:
        category,

      airport_one_id:
        Number.isInteger(
          airportOneId
        )
          ? airportOneId
          : null,

      airport_two_id:
        Number.isInteger(
          airportTwoId
        )
          ? airportTwoId
          : null,

      updated_at:
        now

    });
  }


  return rows;
}


/* ------------------------------------------------------------
   Extract aircraft type specifications.

   We intentionally collapse individual aircraft into one
   authoritative specification per aircraftListName.
------------------------------------------------------------ */

/**
 * buildPlanningAircraftTypes()
 * Extracts and normalises aircraft-type records from planning data.
 */
function buildPlanningAircraftTypes(
  data: any,
  now: string
) {

  const types =
    new Map<
      string,
      PlanningAircraftType
    >();


  for (
    const aircraft of
    data.aircraftDataArray
  ) {

    if (
      !aircraft ||
      typeof aircraft !== "object"
    ) {
      continue;
    }


    const aircraftType =
      String(
        aircraft.aircraftListName || ""
      )
        .trim();


    if (!aircraftType) {
      continue;
    }


    const speed =
      Number(
        aircraft.speed
      );


    const range =
      Number(
        aircraft.range
      );


    const category =
      Number(
        aircraft.category
      );


    if (
      !Number.isFinite(speed) ||
      speed <= 0 ||
      !Number.isFinite(range) ||
      range <= 0 ||
      !Number.isInteger(category) ||
      category <= 0
    ) {

      throw new Error(
        `Invalid specification for aircraft type ${aircraftType}`
      );
    }


    const candidate:
      PlanningAircraftType = {

        aircraft_type:
          aircraftType,

        speed_kmh:
          Math.round(
            speed
          ),

        range_km:
          Math.round(
            range
          ),

        aircraft_category:
          category,

        updated_at:
          now

      };


    const existing =
      types.get(
        aircraftType
      );


    if (existing) {

      if (
        existing.speed_kmh !==
          candidate.speed_kmh ||

        existing.range_km !==
          candidate.range_km ||

        existing.aircraft_category !==
          candidate.aircraft_category
      ) {

        throw new Error(
          `Inconsistent AM specification for ${aircraftType}`
        );
      }


      continue;
    }


    types.set(
      aircraftType,
      candidate
    );
  }


  return Array.from(
    types.values()
  );
}


/**
 * buildPlanningRouteDurations()
 * Extracts route-duration records for aircraft/route planning combinations.
 */
function buildPlanningRouteDurations(
  hub: PlanningHub,
  data: any,
  now: string
) {

  /*
   * Many individual aircraft of the same type can report
   * the same route duration.
   *
   * Reduce those observations to one authoritative record:
   *
   * hub + line + aircraft type
   */

  const durations =
    new Map<
      string,
      PlanningRouteDuration
    >();


  const aircraftArray =
    Array.isArray(
      data.aircraftDataArray
    )
      ? data.aircraftDataArray
      : [];


  for (
    const aircraft of
    aircraftArray
  ) {

    if (
      !aircraft ||
      typeof aircraft !== "object"
    ) {
      continue;
    }


    const aircraftType =
      String(
        aircraft.aircraftListName ||
        ""
      ).trim();


    if (!aircraftType) {
      continue;
    }


    const lineList =
      Array.isArray(
        aircraft.lineList
      )
        ? aircraft.lineList
        : [];


    for (
      const observation of
      lineList
    ) {

      if (
        !observation ||
        typeof observation !== "object"
      ) {
        continue;
      }


      const lineId =
        Number(
          observation.id
        );


      const duration =
        Number(
          observation.duration
        );


      if (
        !Number.isInteger(lineId) ||
        lineId <= 0
      ) {
        continue;
      }


      if (
        !Number.isInteger(duration) ||
        duration <= 0
      ) {
        continue;
      }


      const key =
        `${hub.hubAirportId}:${lineId}:${aircraftType}`;


      const existing =
        durations.get(
          key
        );


      /*
       * If two aircraft of the same type report different
       * durations for the same route, stop rather than
       * silently choosing one.
       */

      if (existing) {

        if (
          existing.duration_seconds !==
          duration
        ) {

          throw new Error(
            `${hub.hubCode}: conflicting AM durations for ` +
            `line ${lineId}, ${aircraftType}: ` +
            `${existing.duration_seconds} vs ${duration}`
          );
        }


        continue;
      }


      durations.set(
        key,
        {
          hub_id:
            hub.hubAirportId,

          line_id:
            lineId,

          aircraft_type:
            aircraftType,

          duration_seconds:
            duration,

          updated_at:
            now
        }
      );
    }
  }


  return Array.from(
    durations.values()
  );
}


/* ------------------------------------------------------------
   UPSERT planning routes.
------------------------------------------------------------ */

/**
 * upsertPlanningRoutes()
 * Upserts parsed planning routes into the planning-route table.
 */
async function upsertPlanningRoutes(
  rows: any[]
) {

  if (
    rows.length === 0
  ) {
    return 0;
  }


  /*
   * Keep batches comfortably below request-size limits.
   */

  const chunkSize =
    500;


  let saved =
    0;


  for (
    let offset = 0;
    offset < rows.length;
    offset += chunkSize
  ) {

    const chunk =
      rows.slice(
        offset,
        offset + chunkSize
      );


    const {
      error
    } =
      await supabase
        .from(
          "am_planning_routes"
        )
        .upsert(
          chunk,
          {
            onConflict:
              "hub_id,line_id"
          }
        );


    if (error) {

      throw new Error(
        `Could not save Planning routes: ${error.message}`
      );
    }


    saved +=
      chunk.length;
  }


  return saved;
}


/* ------------------------------------------------------------
   UPSERT aircraft types.
------------------------------------------------------------ */

/**
 * upsertPlanningAircraftTypes()
 * Upserts aircraft-type metadata derived from planning data.
 */
async function upsertPlanningAircraftTypes(
  rows:
    PlanningAircraftType[]
) {

  if (
    rows.length === 0
  ) {
    return 0;
  }


  const {
    error
  } =
    await supabase
      .from(
        "am_aircraft_types"
      )
      .upsert(
        rows,
        {
          onConflict:
            "aircraft_type"
        }
      );


  if (error) {

    throw new Error(
      `Could not save aircraft types: ${error.message}`
    );
  }


  return rows.length;
}

/**
 * upsertPlanningRouteDurations()
 * Upserts route-duration data derived from planning data.
 */
async function upsertPlanningRouteDurations(
  rows: PlanningRouteDuration[]
) {

  if (
    rows.length === 0
  ) {
    return;
  }


  const chunkSize = 500;


  for (
    let offset = 0;
    offset < rows.length;
    offset += chunkSize
  ) {

    const chunk =
      rows.slice(
        offset,
        offset + chunkSize
      );


    const {
      error
    } =
      await supabase
        .from(
          "am_planning_route_durations"
        )
        .upsert(
          chunk,
          {
            onConflict:
              "hub_id,line_id,aircraft_type"
          }
        );


    if (error) {

      throw new Error(
        `Could not upsert planning route durations: ${error.message}`
      );
    }
  }
}

/* ------------------------------------------------------------
   MAIN PLANNING SCAN
------------------------------------------------------------ */

/**
 * scanPlanning()
 * Orchestrates the planning-data collection and database update workflow.
 */
async function scanPlanning() {

  const startedAt =
    new Date().toISOString();


  /*
   * One authenticated AM session for the complete Planning scan.
   */

  const session =
    await createAmSession();


  const planningPage =
    await fetchAmPage(
      session.jar,
      `${AM_BASE}/network/planning`,
      AM_BASE
    );


  if (!planningPage.ok) {

    throw new Error(
      planningPage.error ||
      `Planning page HTTP ${planningPage.status}`
    );
  }


  const hubs =
    extractPlanningHubs(
      planningPage.html
    );


  if (
    hubs.length === 0
  ) {

    throw new Error(
      "No Planning hubs were discovered."
    );
  }


  /*
   * Build everything in memory first.
   *
   * We deliberately do not write anything to Supabase until
   * every AM Planning dataset has passed validation.
   */

const allRouteRows:
  any[] = [];


const allDurationRows:
  PlanningRouteDuration[] = [];


const allAircraftTypes =
  new Map<
    string,
    PlanningAircraftType
  >();


const hubResults:
  any[] = [];

  for (
    let index = 0;
    index < hubs.length;
    index++
  ) {

    const hub =
      hubs[index];


    const fetched =
      await fetchPlanningDataset(
        session.jar,
        hub.planningId
      );


    const data =
      fetched.data;


    const returnedHubAirportId =
      Number(
        data.hubAirportId
      );


    /*
     * This is an important safety check.
     *
     * The airport ID encoded in the HTML button must agree
     * with the JSON dataset returned for its planning ID.
     */

    if (
      returnedHubAirportId !==
        hub.hubAirportId
    ) {

      throw new Error(
        `${hub.hubCode}: Planning dataset mismatch. ` +
        `Expected hubAirportId ${hub.hubAirportId}, ` +
        `received ${returnedHubAirportId}.`
      );
    }


    const now =
      new Date().toISOString();


    const routeRows =
      buildPlanningRouteRows(
        hub,
        data,
        now
      );


    const aircraftTypes =
      buildPlanningAircraftTypes(
        data,
        now
      );

    const durationRows =
  buildPlanningRouteDurations(
    hub,
    data,
    now
  );


    /*
     * Validate aircraft specifications across hubs before
     * anything is written to Supabase.
     */

    for (
      const aircraftType of
      aircraftTypes
    ) {

      const existing =
        allAircraftTypes.get(
          aircraftType.aircraft_type
        );


      if (existing) {

        if (
          existing.speed_kmh !==
            aircraftType.speed_kmh ||

          existing.range_km !==
            aircraftType.range_km ||

          existing.aircraft_category !==
            aircraftType.aircraft_category
        ) {

          throw new Error(
            `Aircraft specification mismatch across hubs for ` +
            aircraftType.aircraft_type
          );
        }


      } else {

        allAircraftTypes.set(
          aircraftType.aircraft_type,
          aircraftType
        );
      }
    }


allRouteRows.push(
  ...routeRows
);


allDurationRows.push(
  ...durationRows
);


hubResults.push({
      hubCode:
        hub.hubCode,

      hubAirportId:
        hub.hubAirportId,

      planningId:
        hub.planningId,

      frozen:
        hub.frozen,

      httpStatus:
        fetched.httpStatus,

      attempts:
        fetched.attempts,

      routes:
        routeRows.length,

      aircraft:
        data.aircraftDataArray.length,

aircraftTypes:
  aircraftTypes.length,

durationRecords:
  durationRows.length

});

    if (
      index <
      hubs.length - 1
    ) {

      await sleep(
        REQUEST_DELAY_MS
      );
    }
  }


  /*
   * Detect duplicate route keys before UPSERT.
   */

  const routeKeys =
    new Set<string>();


  for (
    const route of
    allRouteRows
  ) {

    const key =
      `${route.hub_id}:${route.line_id}`;


    if (
      routeKeys.has(
        key
      )
    ) {

      throw new Error(
        `Duplicate Planning route key ${key}`
      );
    }


    routeKeys.add(
      key
    );
  }

/*
 * Detect duplicate duration keys before UPSERT.
 */

const durationKeys =
  new Set<string>();


for (
  const row of
  allDurationRows
) {

  const key =
    `${row.hub_id}:${row.line_id}:${row.aircraft_type}`;


  if (
    durationKeys.has(
      key
    )
  ) {

    throw new Error(
      `Duplicate Planning duration key ${key}`
    );
  }


  durationKeys.add(
    key
  );
}

  /*
   * All AM data has now passed validation.
   *
   * Supabase writes begin here.
   */

  const routesUpserted =
    await upsertPlanningRoutes(
      allRouteRows
    );


  const aircraftTypeRows =
    Array.from(
      allAircraftTypes.values()
    );


const aircraftTypesUpserted =
  await upsertPlanningAircraftTypes(
    aircraftTypeRows
  );


const routeDurationsUpserted =
  await upsertPlanningRouteDurations(
    allDurationRows
  );


const completedAt =    new Date().toISOString();


  return {

    ok: true,

    action:
      "scan-planning",

    airlinesManagerReadOnly:
      true,

    databaseMode:
      "upsert-only",

    startedAt,

    completedAt,

    hubsFound:
      hubs.length,

    hubsScanned:
      hubResults.length,

routesUpserted,

aircraftTypesUpserted,

routeDurationsUpserted,

hubs:
  hubResults
  
  };
}

/* ============================================================
   MAIN
============================================================ */



/**
 * HTTP ENTRY POINT
 * Routes incoming API actions to scanning, progress, optimiser, pricing
 * diagnostics/update logging, and planning workflows. Returns JSON
 * responses with CORS headers and reports exceptions as HTTP 500.
 * Carefully restrict invocation because the Supabase client uses a
 * service-role credential and the function authenticates to AM.
 */
Deno.serve(

  async (

    request

  ) => {



    /* ======================================================

       CORS PREFLIGHT

    ====================================================== */



    if (

      request.method === "OPTIONS"

    ) {

      return new Response(

        "ok",

        {

          status: 200,

          headers:

            corsHeaders,

        }

      );

    }





    try {

            const url =

        new URL(

          request.url

        );





      /*

       * ACTIONS

       *

       * start

       * latest

       * batch

       * status

       * results

       */



      const action =

        (

          url.searchParams.get(

            "action"

          ) ||

          "status"

        )

          .toLowerCase();



/* ======================================================
   PLANNING DATA SCAN

   Airlines Manager: READ ONLY
   Supabase: UPSERT ONLY
====================================================== */

if (
  action ===
    "scan-planning"
) {

  try {

    const result =
      await scanPlanning();


    return jsonResponse(
      result,
      200
    );


  } catch (error) {

    const message =
      error instanceof Error
        ? error.message
        : String(error);


    console.error(
      "Planning scan failed:",
      message
    );


    return jsonResponse(
      {
        ok: false,

        action:
          "scan-planning",

        airlinesManagerReadOnly:
          true,

        databaseMode:
          "upsert-only",

        error:
          message
      },
      500
    );
  }
}
      /* ======================================================

         START

      ====================================================== */



      if (

        action === "start"

      ) {



        const scan =

          await createScan();



        return jsonResponse({

          ok: true,



          action:

            "start",



          scan,



          next: {

            action:

              "batch",



            scanId:

              scan.id,



            mode:

              null,



            startPage:

              null,



            batchSize:

              DEFAULT_BATCH_SIZE,

          },

        });

      }





/* ======================================================

   LATEST COMPLETED SCAN

====================================================== */



if (

  action === "latest"

) {



  const latestScan =

    await getLatestCompletedScan();





  if (!latestScan) {



    return jsonResponse({



      ok: true,



      action:

        "latest",



      scan:

        null,



      hasCompletedScan:

        false,

    });

  }





  return jsonResponse({



    ok: true,



    action:

      "latest",



    hasCompletedScan:

      true,



    scan: {



      id:

        latestScan.id,



      hubId:

        latestScan.hub_id,



      hubCode:

        latestScan.hub_code,



      hubsDiscovered:
        latestScan.hubs_discovered || 1,

      hubsComplete:
        latestScan.hubs_complete || 0,

      status:

        latestScan.status,



      startedAt:

        latestScan.started_at ||

        latestScan.created_at ||

        null,



      completedAt:

        latestScan.completed_at,



      auditRoutes:

        latestScan.audit_routes,



      pricingRoutes:

        latestScan.pricing_routes,



      auditPagesComplete:

        latestScan.audit_pages_complete,



      pricingPagesComplete:

        latestScan.pricing_pages_complete,

    },

  });

}

      /*

       * STATUS and BATCH need an existing scan.

       */



      const scanId =

        url.searchParams.get(

          "scanId"

        );





      if (!scanId) {

        return jsonResponse(

          {

            ok: false,

            error:

              "scanId is required",

          },

          400

        );

      }





      /*

       * Also verifies that the supplied UUID actually

       * belongs to a scan.

       */

      const scan =

        await getScan(

          scanId

        );


    /* ======================================================
       PRICE STATUS
    ====================================================== */

    if (action === "price-status") {

      const hubId =
        Number(
          url.searchParams.get("hubId")
        );

      const routeId =
        Number(
          url.searchParams.get("routeId")
        );

      if (
        !Number.isInteger(hubId) ||
        hubId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid hubId is required"
          },
          400
        );
      }

      if (
        !Number.isInteger(routeId) ||
        routeId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid routeId is required"
          },
          400
        );
      }

      const state =
        await getPriceStatus(
          scanId,
          hubId,
          routeId
        );

      return jsonResponse({
        ok: true,
        action: "price-status",
        scanId,
        hubId,
        hubCode:
          state.route?.hub_code || null,
        routeId,
        route:
          state.route?.route || null,
        amendable:
          state.amendable,
        affiliatedLocked:
          state.affiliatedLocked,
        priceLock:
          state.priceLock
      });
    }


    /* ======================================================
       LIVE PRICE STATUS
       READ ONLY
    ====================================================== */

    if (
      action === "live-price-status"
    ) {

      const hubId =
        Number(
          url.searchParams.get("hubId")
        );

      const routeId =
        Number(
          url.searchParams.get("routeId")
        );

      if (
        !Number.isInteger(hubId) ||
        hubId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid hubId is required"
          },
          400
        );
      }

      if (
        !Number.isInteger(routeId) ||
        routeId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid routeId is required"
          },
          400
        );
      }

      const result =
        await getLivePriceStatus(
          scanId,
          hubId,
          routeId
        );

      return jsonResponse({
        ok: true,
        action:
          "live-price-status",
        scanId,
        hubId,
        hubCode:
          result?.route?.hub_code ||
          null,
        routeId,
        ...result
      });
    }


    /* ========================================================
       PRICING FORM STATUS
       READ ONLY
    ======================================================== */

    if (
      action ===
      "pricing-form-status"
    ) {

      const hubId =
        Number(
          url.searchParams.get("hubId")
        );

      const routeId =
        Number(
          url.searchParams.get("routeId")
        );

      if (
        !Number.isInteger(hubId) ||
        hubId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid hubId is required"
          },
          400
        );
      }

      if (
        !Number.isInteger(routeId) ||
        routeId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid routeId is required"
          },
          400
        );
      }

      const result =
        await getPricingFormStatus(
          scanId,
          hubId,
          routeId
        );

      return jsonResponse(
        {
          action:
            "pricing-form-status",
          scanId,
          hubId,
          routeId,
          ...result
        },
        result.ok ? 200 : 400
      );
    }


    /* ========================================================
       SESSION / CSRF DIAGNOSTIC
       READ ONLY - NO PRICE POST
    ======================================================== */

    if (
      action ===
      "session-csrf-diagnostic"
    ) {

      const hubId =
        Number(
          url.searchParams.get("hubId")
        );

      const routeId =
        Number(
          url.searchParams.get("routeId")
        );

      if (
        !Number.isInteger(hubId) ||
        hubId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid hubId is required"
          },
          400
        );
      }

      if (
        !Number.isInteger(routeId) ||
        routeId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid routeId is required"
          },
          400
        );
      }

      const result =
        await getSessionCsrfDiagnostic(
          scanId,
          hubId,
          routeId
        );

      return jsonResponse(
        {
          action:
            "session-csrf-diagnostic",
          scanId,
          hubId,
          routeId,
          ...result
        },
        result.ok ? 200 : 409
      );
    }


    /* ========================================================
       SESSION / COOKIE DIAGNOSTIC
       READ ONLY - NO PRICE POST
    ======================================================== */

    if (
      action ===
      "session-diagnostic"
    ) {

      const hubId =
        Number(
          url.searchParams.get("hubId")
        );

      const routeId =
        Number(
          url.searchParams.get("routeId")
        );

      if (
        !Number.isInteger(hubId) ||
        hubId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid hubId is required"
          },
          400
        );
      }

      if (
        !Number.isInteger(routeId) ||
        routeId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid routeId is required"
          },
          400
        );
      }

      const result =
        await getSessionDiagnostic(
          scanId,
          hubId,
          routeId
        );

      return jsonResponse(
        {
          action:
            "session-diagnostic",
          scanId,
          hubId,
          routeId,
          ...result
        },
        result.ok ? 200 : 400
      );
    }


    /* ========================================================
       RECORD VERIFIED BROWSER SUCCESS
    ======================================================== */

    if (
      action ===
      "record-browser-success"
    ) {

      if (
        request.method !== "POST"
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "record-browser-success requires POST"
          },
          405
        );
      }

      let body: any = {};

      try {
        body =
          await request.json();
      } catch {
        body = {};
      }

      const hubId =
        Number(
          body.hubId ??
          url.searchParams.get("hubId")
        );

      const routeId =
        Number(
          body.routeId ??
          url.searchParams.get("routeId")
        );

      const suppliedHubCodeRaw =
        body.hubCode ??
        url.searchParams.get("hubCode");

      const suppliedHubCode =
        suppliedHubCodeRaw === null ||
        suppliedHubCodeRaw === undefined ||
        String(suppliedHubCodeRaw).trim() === ""
          ? null
          : String(suppliedHubCodeRaw)
              .trim()
              .toUpperCase();

      if (
        !Number.isInteger(hubId) ||
        hubId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid hubId is required"
          },
          400
        );
      }

      if (
        !Number.isInteger(routeId) ||
        routeId <= 0
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "A valid routeId is required"
          },
          400
        );
      }

      if (
        suppliedHubCode !== null &&
        !/^[A-Z0-9]{3}$/.test(
          suppliedHubCode
        )
      ) {
        return jsonResponse(
          {
            ok: false,
            error:
              "hubCode must be a valid three-character hub code"
          },
          400
        );
      }

      const result =
        await recordBrowserSuccess(
          scanId,
          hubId,
          routeId,
          suppliedHubCode
        );

      return jsonResponse(
        {
          action:
            "record-browser-success",
          scanId,
          hubId,
          hubCode:
            result.hubCode ||
            suppliedHubCode ||
            null,
          routeId,
          ...result
        },
        result.ok ? 200 : 409
      );
    }

    
      /* ======================================================

      RESULTS

    ====================================================== */



    if (

      action === "results"

    ) {



      const results =

        await getOptimiserResults(

          scanId

        );





      return jsonResponse({

        ok: true,



        action:

          "results",



        scanId,



        ...results,

      });

    }



      /* ======================================================

         STATUS

      ====================================================== */



      if (
        action === "status"
      ) {
        const counts =
          await refreshScanCounts(scanId);

        const nextWork =
          await findNextWork(scanId);

        return jsonResponse({
          ok: true,
          action: "status",
          scanId,
          status:
            counts.complete
              ? "complete"
              : scan.status,
          progress: {
            audit: {
              pagesComplete: counts.auditPages,
              totalPages: counts.auditTotalPages,
              routes: counts.auditRoutes,
            },
            pricing: {
              pagesComplete: counts.pricingPages,
              totalPages: counts.pricingTotalPages,
              routes: counts.pricingRoutes,
            },
            hubs: {
              complete: counts.hubsComplete,
              total: counts.hubsDiscovered,
              items: counts.hubs,
            },
          },
          next:
            nextWork
              ? {
                  hubId: Number(nextWork.hub.hub_id),
                  hubCode: nextWork.hub.hub_code,
                  mode: nextWork.mode,
                  page: nextWork.page,
                }
              : null,
          lastError: scan.last_error,
          complete: counts.complete,
        });
      }


      /* ======================================================
         BATCH
      ====================================================== */

      if (
        action === "batch"
      ) {
        let mode =
          (
            url.searchParams.get("mode") ||
            ""
          ).toLowerCase();

        let requestedMode:
          | "audit"
          | "pricing"
          | null = null;

        if (mode) {
          if (
            mode !== "audit" &&
            mode !== "pricing"
          ) {
            return jsonResponse(
              {
                ok: false,
                error:
                  "mode must be audit or pricing",
              },
              400
            );
          }

          requestedMode =
            mode as "audit" | "pricing";
        }

        const startPageRaw =
          url.searchParams.get("startPage");

        let requestedStartPage:
          number | null = null;

        if (
          startPageRaw !== null &&
          startPageRaw !== ""
        ) {
          const parsed =
            Number.parseInt(
              startPageRaw,
              10
            );

          if (!Number.isFinite(parsed)) {
            return jsonResponse(
              {
                ok: false,
                error:
                  "startPage must be an integer",
              },
              400
            );
          }

          requestedStartPage = parsed;
        }

        const batchSizeRaw =
          Number.parseInt(
            url.searchParams.get("batchSize") ||
            String(DEFAULT_BATCH_SIZE),
            10
          );

        const batchSize =
          Math.min(
            Math.max(
              Number.isFinite(batchSizeRaw)
                ? batchSizeRaw
                : DEFAULT_BATCH_SIZE,
              1
            ),
            MAX_BATCH_SIZE
          );

        /*
         * Hub selection is deliberately server-side.
         * Existing frontends can continue sending mode/startPage;
         * the scanner always resumes the first incomplete hub/page.
         */
        const result =
          await scanBatch(
            scanId,
            requestedMode,
            requestedStartPage,
            batchSize
          );

        const counts =
          await refreshScanCounts(scanId);

        const nextWork =
          await findNextWork(scanId);

        const failedPage =
          result.pages.find(
            (page: any) => !page.ok
          ) || null;

        return jsonResponse({
          ok: !failedPage,
          action: "batch",
          scanId,
          batch: result,
          progress: {
            audit: {
              pagesComplete: counts.auditPages,
              totalPages: counts.auditTotalPages,
              routes: counts.auditRoutes,
            },
            pricing: {
              pagesComplete: counts.pricingPages,
              totalPages: counts.pricingTotalPages,
              routes: counts.pricingRoutes,
            },
            hubs: {
              complete: counts.hubsComplete,
              total: counts.hubsDiscovered,
              items: counts.hubs,
            },
          },
          complete: counts.complete,
          failedPage,
          next:
            counts.complete || !nextWork
              ? null
              : {
                  action: "batch",
                  hubId: Number(nextWork.hub.hub_id),
                  hubCode: nextWork.hub.hub_code,
                  mode: nextWork.mode,
                  startPage: nextWork.page,
                  batchSize,
                },
        });
      }


      /* ======================================================

         UNKNOWN ACTION

      ====================================================== */



      return jsonResponse(

        {

          ok: false,

          error:

            "Unknown action",

        },

        400

      );



    } catch (

      error

    ) {



      console.error(

        error

      );





      return jsonResponse(

        {

          ok: false,



          error:

            error instanceof Error

              ? error.message

              : String(error),

        },

        500

      );

    }

  }

);
