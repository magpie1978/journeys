/**
 * recordScanError()
 * Stores the latest error on the scan and optionally on a specific hub.
 */
async function recordScanError(
  scanId: string,
  message: string | null,
  hubId?: number
) {
  const { error } =
    await supabase
      .from("am_scans")
      .update({ last_error: message })
      .eq("id", scanId);

  if (error) {
    console.error(
      "Could not record scan error:",
      error.message
    );
  }

  if (hubId !== undefined) {
    await supabase
      .from("am_scan_hubs")
      .update({
        last_error: message,
        updated_at: new Date().toISOString(),
      })
      .eq("scan_id", scanId)
      .eq("hub_id", hubId);
  }
}


/* ============================================================

   FIND NEXT INCOMPLETE PAGE

============================================================ */



/**
 * findNextPageForHub()
 * Returns the first page in a hub/mode not yet recorded as complete.
 */
async function findNextPageForHub(
  scanId: string,
  hubId: number,
  mode: "audit" | "pricing",
  totalPages: number
) {
  if (totalPages <= 0) {
    return null;
  }

  const { data, error } =
    await supabase
      .from("am_scan_pages")
      .select("page_number,status")
      .eq("scan_id", scanId)
      .eq("hub_id", hubId)
      .eq("mode", mode)
      .eq("status", "complete");

  if (error) {
    throw new Error(
      `Could not determine scan progress: ${error.message}`
    );
  }

  const completed =
    new Set(
      (data || []).map(
        row => Number(row.page_number)
      )
    );

  for (let page = 1; page <= totalPages; page++) {
    if (!completed.has(page)) {
      return page;
    }
  }

  return null;
}


/**
 * findNextWork()
 * Selects the next incomplete hub/page, respecting a preferred mode before falling back.
 */
async function findNextWork(
  scanId: string,
  preferredMode?: "audit" | "pricing" | null
) {
  const hubs = await getScanHubs(scanId);

  const modes: Array<"audit" | "pricing"> =
    preferredMode
      ? [preferredMode]
      : ["audit", "pricing"];

  for (const mode of modes) {
    for (const hub of hubs) {
      const totalPages =
        Number(
          mode === "audit"
            ? hub.audit_total_pages
            : hub.pricing_total_pages
        ) || 0;

      const page =
        await findNextPageForHub(
          scanId,
          Number(hub.hub_id),
          mode,
          totalPages
        );

      if (page !== null) {
        return {
          hub,
          mode,
          page,
          totalPages,
        };
      }
    }
  }

  /*
   * If the caller preferred one mode and it is finished everywhere,
   * automatically continue into the other mode.
   */
  if (preferredMode) {
    const other =
      preferredMode === "audit"
        ? "pricing"
        : "audit";

    return findNextWork(scanId, other);
  }

  return null;
}


/* ============================================================
   SCAN ONE BATCH
============================================================ */

/**
 * scanBatch()
 * Processes a bounded batch of pages with authentication, parsing, validation and database persistence.
 */
async function scanBatch(
  scanId: string,
  requestedMode: "audit" | "pricing" | null,
  _requestedStartPage: number | null,
  batchSize: number
) {
  const work =
    await findNextWork(
      scanId,
      requestedMode
    );

  if (!work) {
    return {
      mode: requestedMode,
      alreadyComplete: true,
      pages: [],
    };
  }

  const hub = work.hub;
  const hubId = Number(hub.hub_id);
  const hubCode = String(hub.hub_code);
  const mode = work.mode;
  const totalPages = work.totalPages;
  const startPage = work.page;

  const endPage =
    Math.min(
      startPage + batchSize - 1,
      totalPages
    );

    /*
    * audit_routes is the number of routes already saved during this scan,
    * not the expected total number of routes for the hub.
    *
    * Therefore it must not be used to calculate the expected size of the
    * final Audit page.
    */
    const expectedTotalRoutes = null;

  const session =
    await createAmSession();

  const pageResults: any[] = [];

  await supabase
    .from("am_scan_hubs")
    .update({
      status: "scanning",
      started_at:
        hub.started_at ||
        new Date().toISOString(),
      updated_at:
        new Date().toISOString(),
    })
    .eq("scan_id", scanId)
    .eq("hub_id", hubId);

  for (
    let page = startPage;
    page <= endPage;
    page++
  ) {
    const pageUrl =
      mode === "audit"
        ? `${AM_BASE}/marketing/internalaudit/linelist?airport=${hubId}&page=${page}&line=`
        : `${AM_BASE}/marketing/pricing/?airport=${hubId}&page=${page}`;

    const referer =
      mode === "audit"
        ? `${AM_BASE}/marketing/internalaudit/linelist?airport=${hubId}&page=1&line=`
        : `${AM_BASE}/marketing/pricing/?airport=${hubId}&page=1`;

    const fetched =
      await fetchAmPage(
        session.jar,
        pageUrl,
        referer
      );

    if (!fetched.ok) {
      await savePageStatus(
        scanId,
        hubId,
        hubCode,
        mode,
        page,
        "failed",
        fetched.status,
        fetched.attempts,
        0,
        fetched.error
      );

      await recordScanError(
        scanId,
        `${hubCode} ${mode} page ${page}: ${fetched.error}`,
        hubId
      );

      pageResults.push({
        hubId,
        hubCode,
        page,
        ok: false,
        status: fetched.status,
        attempts: fetched.attempts,
        routesParsed: 0,
        validationPassed: false,
        error: fetched.error,
      });

      break;
    }

    const routes =
      mode === "audit"
        ? parseAuditPage(
            fetched.html,
            page,
            hubCode
          )
        : parsePricingPage(
            fetched.html,
            page,
            hubCode
          );

    const validation =
      validateParsedPage(
        mode,
        page,
        routes,
        totalPages,
        expectedTotalRoutes
      );

    if (!validation.valid) {
      await savePageStatus(
        scanId,
        hubId,
        hubCode,
        mode,
        page,
        "failed",
        fetched.status,
        fetched.attempts,
        routes.length,
        validation.error
      );

      await recordScanError(
        scanId,
        `${hubCode}: ${validation.error}`,
        hubId
      );

      pageResults.push({
        hubId,
        hubCode,
        page,
        ok: false,
        status: fetched.status,
        attempts: fetched.attempts,
        routesParsed: routes.length,
        expectedRoutes: validation.expected,
        validationPassed: false,
        error: validation.error,
      });

      break;
    }

    await saveValidatedRoutes(
      scanId,
      hubId,
      hubCode,
      mode,
      routes
    );

    await savePageStatus(
      scanId,
      hubId,
      hubCode,
      mode,
      page,
      "complete",
      fetched.status,
      fetched.attempts,
      routes.length,
      null
    );

    await recordScanError(
      scanId,
      null,
      hubId
    );

    pageResults.push({
      hubId,
      hubCode,
      page,
      ok: true,
      status: fetched.status,
      attempts: fetched.attempts,
      routesParsed: routes.length,
      expectedRoutes: validation.expected,
      validationPassed: true,
      error: null,
    });

    if (page < endPage) {
      await sleep(REQUEST_DELAY_MS);
    }
  }

  return {
    hubId,
    hubCode,
    hubName: hub.hub_name || null,
    mode,
    startPage,
    endPage,
    totalPages,
    authentication: {
      loginStatus: session.loginStatus,
      loginRedirect: session.loginRedirect,
    },
    pages: pageResults,
  };
}


