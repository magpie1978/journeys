/**
 * parsePricingPage()
 * Parses pricing list rows and remaining-demand rows, calculating capacity as demand minus remaining demand.
 */
function parsePricingPage(
  html: string,
  sourcePage: number,
  hubCode: string
) {



  const rows =

    getRows(html);



  const routes: any[] = [];





  for (

    let i = 0;

    i < rows.length;

    i++

  ) {



    const row =

      rows[i];





    const route =

      canonicalRoute(
        row.text,
        hubCode
      );





    if (!route) {

      continue;

    }





    /*

     * Route rows contain:

     *

     * /marketing/pricing/{routeId}

     */



    const idMatch =

      row.html.match(

        /\/marketing\/pricing\/(\d+)/i

      );





    if (!idMatch) {

      continue;

    }





    /*

     * Example:

     *

     * BKK / KAN - 9,930 km

     * 5 873 Pax

     * 230 Pax

     * 24 Pax

     * 632 Tonnes

     */



    const distanceMatch =

      row.text.match(

        /([\d\s,]+)\s*km\b/i

      );





    const paxMatches =

      Array.from(

        row.text.matchAll(

          /(-?[\d\s,]+)\s*Pax\b/gi

        )

      );





    const cargoMatch =

      row.text.match(

        /(-?[\d\s,]+)\s*Tonnes?\b/i

      );





    if (

      paxMatches.length < 3 ||

      !cargoMatch

    ) {

      continue;

    }





    const demandEconomy =

      parseNumber(

        paxMatches[0][1]

      );



    const demandBusiness =

      parseNumber(

        paxMatches[1][1]

      );



    const demandFirst =

      parseNumber(

        paxMatches[2][1]

      );



    const demandCargo =

      parseNumber(

        cargoMatch[1]

      );





    if (

      demandEconomy === null ||

      demandBusiness === null ||

      demandFirst === null ||

      demandCargo === null

    ) {

      continue;

    }





    /*

     * Next row:

     *

     * Remaining demand -119 Pax ...

     */



    const nextRow =

      rows[i + 1];





    if (

      !nextRow ||

      !/^Remaining demand\b/i.test(

        nextRow.text

      )

    ) {

      continue;

    }





    const remainingPax =

      Array.from(

        nextRow.text.matchAll(

          /(-?[\d\s,]+)\s*Pax\b/gi

        )

      );





    const remainingCargo =

      nextRow.text.match(

        /(-?[\d\s,]+)\s*Tonnes?\b/i

      );





    if (

      remainingPax.length < 3 ||

      !remainingCargo

    ) {

      continue;

    }





    const remainingEconomy =

      parseNumber(

        remainingPax[0][1]

      );



    const remainingBusiness =

      parseNumber(

        remainingPax[1][1]

      );



    const remainingFirst =

      parseNumber(

        remainingPax[2][1]

      );



    const remainingCargoValue =

      parseNumber(

        remainingCargo[1]

      );





    if (

      remainingEconomy === null ||

      remainingBusiness === null ||

      remainingFirst === null ||

      remainingCargoValue === null

    ) {

      continue;

    }





    const capacityEconomy =

      demandEconomy -

      remainingEconomy;



    const capacityBusiness =

      demandBusiness -

      remainingBusiness;



    const capacityFirst =

      demandFirst -

      remainingFirst;



    const capacityCargo =

      demandCargo -

      remainingCargoValue;





    routes.push({



      scan_id:

        null,



      route_id:

        Number(

          idMatch[1]

        ),



      route,



      source_page:

        sourcePage,



      distance_km:

        distanceMatch

          ? parseNumber(

              distanceMatch[1]

            )

          : null,



      demand_economy:

        demandEconomy,



      demand_business:

        demandBusiness,



      demand_first:

        demandFirst,



      demand_cargo:

        demandCargo,



      remaining_economy:

        remainingEconomy,



      remaining_business:

        remainingBusiness,



      remaining_first:

        remainingFirst,



      remaining_cargo:

        remainingCargoValue,



      capacity_economy:

        capacityEconomy,



      capacity_business:

        capacityBusiness,



      capacity_first:

        capacityFirst,



      capacity_cargo:

        capacityCargo,

    });

  }





  return routes;

}





