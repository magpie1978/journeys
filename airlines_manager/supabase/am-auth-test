/**
 * savePageStatus()
 * Upserts a page’s success/failure, HTTP status, attempt count and parse details.
 */
async function savePageStatus(
  scanId: string,
  hubId: number,
  hubCode: string,
  mode: "audit" | "pricing",
  pageNumber: number,
  status: "complete" | "failed",
  httpStatus: number | null,
  attempts: number,
  routesParsed: number,
  errorMessage: string | null
) {
  const { error } =
    await supabase
      .from("am_scan_pages")
      .upsert(
        {
          scan_id: scanId,
          hub_id: hubId,
          hub_code: hubCode,
          mode,
          page_number: pageNumber,
          status,
          http_status: httpStatus,
          attempts,
          routes_parsed: routesParsed,
          error_message: errorMessage,
          scanned_at: new Date().toISOString(),
        },
        {
          onConflict:
            "scan_id,hub_id,mode,page_number",
        }
      );

  if (error) {
    throw new Error(
      `Could not save page status: ${error.message}`
    );
  }
}


/* ============================================================
   SAVE SUCCESSFULLY VALIDATED ROUTES
============================================================ */

/**
 * saveValidatedRoutes()
 * Upserts successfully parsed audit or pricing routes for a particular scan and hub.
 */
async function saveValidatedRoutes(
  scanId: string,
  hubId: number,
  hubCode: string,
  mode: "audit" | "pricing",
  routes: any[]
) {
  if (routes.length === 0) {
    return;
  }

  const rows =
    routes.map(route => ({
      ...route,
      scan_id: scanId,
      hub_id: hubId,
      hub_code: hubCode,
    }));

  const table =
    mode === "audit"
      ? "am_audit_routes"
      : "am_pricing_routes";

  const { error } =
    await supabase
      .from(table)
      .upsert(
        rows,
        {
          onConflict:
            "scan_id,hub_id,route_id",
        }
      );

  if (error) {
    throw new Error(
      `Could not save ${mode} routes: ${error.message}`
    );
  }
}


/* ============================================================
   REFRESH SCAN COUNTS
============================================================ */

/**
 * refreshScanCounts()
 * Recounts completed pages/routes per hub and updates aggregate scan completion state.
 */
async function refreshScanCounts(scanId: string) {
  const hubs = await getScanHubs(scanId);
  const now = new Date().toISOString();

  let totalAuditPages = 0;
  let totalPricingPages = 0;
  let auditPages = 0;
  let pricingPages = 0;
  let auditRoutes = 0;
  let pricingRoutes = 0;
  let hubsComplete = 0;

  const refreshedHubs: any[] = [];

  for (const hub of hubs) {
    const hubId = Number(hub.hub_id);

    const [
      auditPagesResult,
      pricingPagesResult,
      auditRoutesResult,
      pricingRoutesResult,
    ] =
      await Promise.all([
        supabase
          .from("am_scan_pages")
          .select("*", { count: "exact", head: true })
          .eq("scan_id", scanId)
          .eq("hub_id", hubId)
          .eq("mode", "audit")
          .eq("status", "complete"),

        supabase
          .from("am_scan_pages")
          .select("*", { count: "exact", head: true })
          .eq("scan_id", scanId)
          .eq("hub_id", hubId)
          .eq("mode", "pricing")
          .eq("status", "complete"),

        supabase
          .from("am_audit_routes")
          .select("*", { count: "exact", head: true })
          .eq("scan_id", scanId)
          .eq("hub_id", hubId),

        supabase
          .from("am_pricing_routes")
          .select("*", { count: "exact", head: true })
          .eq("scan_id", scanId)
          .eq("hub_id", hubId),
      ]);

    for (const result of [
      auditPagesResult,
      pricingPagesResult,
      auditRoutesResult,
      pricingRoutesResult,
    ]) {
      if (result.error) {
        throw new Error(
          `Could not refresh ${hub.hub_code} counts: ${result.error.message}`
        );
      }
    }

    const hubAuditPages =
      auditPagesResult.count || 0;
    const hubPricingPages =
      pricingPagesResult.count || 0;
    const hubAuditRoutes =
      auditRoutesResult.count || 0;
    const hubPricingRoutes =
      pricingRoutesResult.count || 0;

    const hubAuditTotalPages =
      Number(hub.audit_total_pages || 0);
    const hubPricingTotalPages =
      Number(hub.pricing_total_pages || 0);

    const hubComplete =
      hubAuditPages === hubAuditTotalPages &&
      hubPricingPages === hubPricingTotalPages;

    const zeroRoutes =
      hubAuditTotalPages === 0 &&
      hubPricingTotalPages === 0;

    const hubStatus =
      zeroRoutes
        ? "zero_routes"
        : hubComplete
          ? "complete"
          : hub.status === "failed"
            ? "failed"
            : hubAuditPages > 0 || hubPricingPages > 0
              ? "scanning"
              : "pending";

    const hubUpdate: any = {
      audit_pages_complete: hubAuditPages,
      pricing_pages_complete: hubPricingPages,
      audit_routes: hubAuditRoutes,
      pricing_routes: hubPricingRoutes,
      status: hubStatus,
      updated_at: now,
    };

    if (
      (hubComplete || zeroRoutes) &&
      !hub.completed_at
    ) {
      hubUpdate.completed_at = now;
    }

    if (
      (hubAuditPages > 0 || hubPricingPages > 0) &&
      !hub.started_at
    ) {
      hubUpdate.started_at = now;
    }

    const { error: hubUpdateError } =
      await supabase
        .from("am_scan_hubs")
        .update(hubUpdate)
        .eq("scan_id", scanId)
        .eq("hub_id", hubId);

    if (hubUpdateError) {
      throw new Error(
        `Could not update ${hub.hub_code} progress: ${hubUpdateError.message}`
      );
    }

    totalAuditPages += hubAuditTotalPages;
    totalPricingPages += hubPricingTotalPages;
    auditPages += hubAuditPages;
    pricingPages += hubPricingPages;
    auditRoutes += hubAuditRoutes;
    pricingRoutes += hubPricingRoutes;

    if (hubComplete || zeroRoutes) {
      hubsComplete++;
    }

    refreshedHubs.push({
      ...hub,
      ...hubUpdate,
      complete: hubComplete || zeroRoutes,
    });
  }

  const complete =
    hubs.length > 0 &&
    hubsComplete === hubs.length;

  const existingScan =
    await getScan(scanId);

  const updateData: any = {
    audit_total_pages: totalAuditPages,
    pricing_total_pages: totalPricingPages,
    audit_pages_complete: auditPages,
    pricing_pages_complete: pricingPages,
    audit_routes: auditRoutes,
    pricing_routes: pricingRoutes,
    hubs_discovered: hubs.length,
    hubs_complete: hubsComplete,
    status: complete ? "complete" : "running",
  };

  if (complete && !existingScan.completed_at) {
    updateData.completed_at = now;
  }

  const { error } =
    await supabase
      .from("am_scans")
      .update(updateData)
      .eq("id", scanId);

  if (error) {
    throw new Error(
      `Could not update scan counts: ${error.message}`
    );
  }

  return {
    auditPages,
    pricingPages,
    auditRoutes,
    pricingRoutes,
    auditTotalPages: totalAuditPages,
    pricingTotalPages: totalPricingPages,
    hubsDiscovered: hubs.length,
    hubsComplete,
    hubs: refreshedHubs,
    complete,
    completedAt:
      existingScan.completed_at ||
      updateData.completed_at ||
      null,
  };
}


