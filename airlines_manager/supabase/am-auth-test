   COOKIE JAR

============================================================ */



/** CookieJar: keeps session cookies in memory across AM requests. */
class CookieJar {



  cookies =

    new Map<string, string>();





  /** store() — Reads Set-Cookie headers, filters invalid SameSite=None cookies, and stores name/value pairs. */
  store(

    response: Response

  ) {

    let setCookies:

      string[] = [];





    const headersAny =

      response.headers as any;





    if (

      typeof headersAny.getSetCookie ===

      "function"

    ) {

      setCookies =

        headersAny.getSetCookie();



    } else {

      const fallback =

        response.headers.get(

          "set-cookie"

        );



      if (fallback) {

        setCookies =

          [fallback];

      }

    }





    for (

      const cookieString

      of setCookies

    ) {

      // Match modern browser cookie acceptance for SameSite=None.
      // Browsers reject SameSite=None cookies unless Secure is also present.
      // This matters here because a server-side cookie jar would otherwise
      // retain cookies that Chrome silently rejects and never sends back.
      const cookieParts =

        cookieString
          .split(";")
          .map(part => part.trim());



      const firstPart =

        cookieParts[0] || "";



      const attributes =

        cookieParts
          .slice(1)
          .map(part => part.toLowerCase());



      const sameSiteNone =

        attributes.some(attribute =>
          /^samesite\s*=\s*none$/i.test(attribute)
        );



      const secure =

        attributes.some(attribute =>
          attribute === "secure"
        );



      if (sameSiteNone && !secure) {
        continue;
      }



      const separator =

        firstPart.indexOf("=");





      if (separator <= 0) {

        continue;

      }





      const name =

        firstPart

          .slice(

            0,

            separator

          )

          .trim();



      const value =

        firstPart

          .slice(

            separator + 1

          )

          .trim();





      this.cookies.set(

        name,

        value

      );

    }

  }





  /** header() — Serialises saved cookies into the HTTP Cookie request header. */
  header() {

    return Array.from(

      this.cookies.entries()

    )

      .map(

        ([name, value]) =>

          `${name}=${value}`

      )

      .join("; ");

  }

}




/** Type: CookieStage — In-memory snapshot of session cookies at a named diagnostic stage. */
type CookieStage = {
  stage: string;
  cookies: Map<string, string>;
};

/**
 * captureCookieStage()
 * Snapshots cookie names and values in memory for later session-change diagnostics.
 */
function captureCookieStage(
  stages: CookieStage[],
  stage: string,
  jar: CookieJar
) {
  // Copy values only in memory so we can detect changes.
  // Values are never returned by the diagnostic endpoint.
  stages.push({
    stage,
    cookies: new Map(jar.cookies),
  });
}

/**
 * safeCookieStageReport()
 * Reports cookie names and added/changed/removed names without returning cookie values.
 */
function safeCookieStageReport(stages: CookieStage[]) {
  return stages.map((current, index) => {
    const previous = index > 0 ? stages[index - 1] : null;
    const currentNames = Array.from(current.cookies.keys()).sort();

    if (!previous) {
      return {
        stage: current.stage,
        cookieNames: currentNames,
        count: currentNames.length,
        added: currentNames,
        changed: [],
        removed: [],
      };
    }

    const previousNames = new Set(previous.cookies.keys());
    const currentNameSet = new Set(current.cookies.keys());

    const added = currentNames.filter(name => !previousNames.has(name));
    const removed = Array.from(previousNames)
      .filter(name => !currentNameSet.has(name))
      .sort();
    const changed = currentNames
      .filter(name =>
        previous.cookies.has(name) &&
        previous.cookies.get(name) !== current.cookies.get(name)
      )
      .sort();

    return {
      stage: current.stage,
      cookieNames: currentNames,
      count: currentNames.length,
      added,
      changed,
      removed,
    };
  });
}


