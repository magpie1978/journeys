/* ============================================================
   SINGLE-ROUTE PRICE UPDATES + 24-HOUR LOCK
============================================================ */

const PRICE_LOCK_MS = 24 * 60 * 60 * 1000;

/**
 * priceLock()
 * Interprets a price update timestamp to determine whether a price-change lock remains active.
 */
function priceLock(updatedAt: string | null) {
  if (!updatedAt) return { locked:false, updatedAt:null, unlockAt:null, remainingMs:0 };
  const changed = new Date(updatedAt).getTime();
  if (!Number.isFinite(changed)) return { locked:false, updatedAt, unlockAt:null, remainingMs:0 };
  const unlock = changed + PRICE_LOCK_MS;
  const remainingMs = Math.max(0, unlock - Date.now());
  return { locked:remainingMs > 0, updatedAt, unlockAt:new Date(unlock).toISOString(), remainingMs };
}

/**
 * latestSuccessfulUpdate()
 * Looks up the latest successful price update for a route.
 */
async function latestSuccessfulUpdate(
  hubId: number,
  routeId: number
) {
  const { data, error } =
    await supabase
      .from("am_price_updates")
      .select(
        "id,hub_id,route_id,updated_at"
      )
      .eq("hub_id", hubId)
      .eq("route_id", routeId)
      .eq("status", "success")
      .not("updated_at", "is", null)
      .order(
        "updated_at",
        { ascending: false }
      )
      .limit(1)
      .maybeSingle();

  if (error) {
    throw new Error(
      `Could not load price-update history: ${error.message}`
    );
  }

  return data;
}

/**
 * getActivePriceLocks()
 * Collects currently active pricing locks from update history.
 */
async function getActivePriceLocks() {

  const cutoff =
    new Date(
      Date.now() - PRICE_LOCK_MS
    ).toISOString();


  /*
   * IMPORTANT:
   *
   * Price locks are deliberately NOT scan-scoped.
   *
   * A successful price change must remain locked
   * for 24 hours even if a new optimiser scan is
   * performed during that period.
   *
   * Route identity is hub_id + route_id.
   *
   * Supabase/PostgREST limits a normal SELECT to
   * a finite number of rows, so active locks must
   * be fetched in pages.
   */

  const PAGE_SIZE = 1000;

  let from = 0;

  const locks =
    new Map<string, any>();


  while (true) {

    const {
      data,
      error
    } =
      await supabase
        .from(
          "am_price_updates"
        )
        .select(
          "id,hub_id,route_id,updated_at"
        )
        .eq(
          "status",
          "success"
        )
        .not(
          "updated_at",
          "is",
          null
        )
        .gte(
          "updated_at",
          cutoff
        )
        .order(
          "updated_at",
          {
            ascending: false
          }
        )
        .range(
          from,
          from + PAGE_SIZE - 1
        );


    if (error) {

      throw new Error(
        `Could not load active price locks: ${error.message}`
      );

    }


    const rows =
      data || [];


    for (
      const row
      of rows
    ) {

      const hubId =
        Number(
          row.hub_id
        );

      const routeId =
        Number(
          row.route_id
        );


      if (
        !Number.isInteger(hubId) ||
        hubId <= 0 ||
        !Number.isInteger(routeId) ||
        routeId <= 0
      ) {

        continue;

      }


      const key =
        `${hubId}:${routeId}`;


      /*
       * Results are newest first.
       *
       * Therefore the first successful update
       * encountered for this hub/route is the
       * newest one.
       */

      if (
        !locks.has(key)
      ) {

        locks.set(
          key,
          {
            id:
              row.id,

            hubId,

            routeId,

            updatedAt:
              row.updated_at,

            ...priceLock(
              row.updated_at
            ),
          }
        );

      }

    }


    /*
     * A short page means we've reached the end.
     */

    if (
      rows.length <
      PAGE_SIZE
    ) {

      break;

    }


    from +=
      PAGE_SIZE;

  }


  return locks;

}


/**
 * getPriceStatus()
 * Summarises pricing state and lock information for requested routes.
 */
async function getPriceStatus(
  scanId: string,
  hubId: number,
  routeId: number
) {
  /*
   * Pricing/optimiser route.
   *
   * route_id alone is not globally unique across hubs, so the
   * scan, hub and route must all match.
   */
  const {
    data: route,
    error: routeError
  } =
    await supabase
      .from("am_price_optimiser")
      .select("*")
      .eq("scan_id", scanId)
      .eq("hub_id", hubId)
      .eq("route_id", routeId)
      .maybeSingle();

  if (routeError) {
    throw new Error(
      `Could not load optimiser route: ${routeError.message}`
    );
  }

  /*
   * Audit presence determines whether this route is amendable.
   *
   * Again, use the complete scan + hub + route identity.
   */
  const {
    data: audit,
    error: auditError
  } =
    await supabase
      .from("am_audit_routes")
      .select(
        "scan_id,hub_id,hub_code,route_id,route"
      )
      .eq("scan_id", scanId)
      .eq("hub_id", hubId)
      .eq("route_id", routeId)
      .maybeSingle();

  if (auditError) {
    throw new Error(
      `Could not check route amendability: ${auditError.message}`
    );
  }

  /*
   * Price-update history deliberately isn't scan-scoped.
   *
   * A successful update must remain locked for 24 hours even if
   * a new optimiser scan is performed during that period.
   */
  const update =
    await latestSuccessfulUpdate(
      hubId,
      routeId
    );

  return {
    route,

    amendable:
      Boolean(
        route &&
        audit
      ),

    affiliatedLocked:
      !audit,

    priceLock: {
      ...priceLock(
        update?.updated_at ||
        null
      ),

      source:
        update
          ? "am_price_updates"
          : null,

      updateId:
        update?.id ||
        null
    }
  };
}



/**
 * attr()
 * Extracts a named attribute from an HTML tag string.
 */
function attr(tag:string, name:string) {
  const safe = name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const m = tag.match(new RegExp(`${safe}\\s*=\\s*["']([^"']*)["']`, "i"));
  return m ? decodeEntities(m[1]) : null;
}

/**
 * inputById()
 * Finds an input element with a particular ID in HTML.
 */
function inputById(html:string, id:string) {
  const safe = id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const m = html.match(new RegExp(`<input\\b[^>]*\\bid=["']${safe}["'][^>]*>`, "i"));
  return m ? { name:attr(m[0],"name"), value:attr(m[0],"value") || "" } : null;
}

/**
 * hasAttr()
 * Checks whether an HTML tag includes a named attribute.
 */
function hasAttr(tag: string, name: string) {
  return new RegExp(`\\b${name}(?:\\s*=|\\s|>|$)`, "i").test(tag);
}

/**
 * safeInputInfo()
 * Reports selected input properties for diagnostics without exposing secret form values.
 */
function safeInputInfo(tag: string | null) {
  if (!tag) {
    return {
      present: false,
      name: null,
      type: null,
      disabled: false,
      readonly: false
    };
  }

  return {
    present: true,
    name: attr(tag, "name"),
    type: attr(tag, "type") || "text",
    disabled: hasAttr(tag, "disabled"),
    readonly: hasAttr(tag, "readonly")
  };
}

/**
 * inputTagById()
 * Extracts the opening input tag for a particular element ID.
 */
function inputTagById(html: string, id: string) {
  const safe = id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  const m = html.match(
    new RegExp(
      `<input\\b[^>]*\\bid=["']${safe}["'][^>]*>`,
      "i"
    )
  );

  return m ? m[0] : null;
}

/**
 * pricingFormDiagnostic()
 * Inspects pricing form structure and editability for troubleshooting.
 */
function pricingFormDiagnostic(html: string) {

  // Find the exact form containing the Economy price input.
  const forms =
    html.match(/<form\b[\s\S]*?<\/form>/gi) || [];

  const form =
    forms.find(f =>
      /id=["']line_priceEco["']/i.test(f)
    ) || null;

  if (!form) {
    return {
      formFound: false
    };
  }

  const openingTag =
    form.match(/<form\b[^>]*>/i)?.[0] || "";

  const ecoTag =
    inputTagById(form, "line_priceEco");

  const busTag =
    inputTagById(form, "line_priceBus");

  const firstTag =
    inputTagById(form, "line_priceFirst");

  const cargoTag =
    inputTagById(form, "line_priceCargo");


  const inputTags =
    form.match(/<input\b[^>]*>/gi) || [];


  // Return every input structurally, but deliberately suppress
  // values for hidden/password fields so tokens/secrets can never
  // be exposed by this diagnostic.
  const allInputs =
    inputTags.map(tag => {

      const type =
        (attr(tag, "type") || "text")
          .toLowerCase();

      const sensitive =
        type === "hidden" ||
        type === "password";

      return {
        name:
          attr(tag, "name"),

        id:
          attr(tag, "id"),

        type,

        value:
          sensitive
            ? null
            : attr(tag, "value"),

        valueSuppressed:
          sensitive,

        disabled:
          hasAttr(tag, "disabled"),

        readonly:
          hasAttr(tag, "readonly"),

        checked:
          hasAttr(tag, "checked")
      };
    });


  const hiddenInputs =
    allInputs
      .filter(input =>
        input.type === "hidden"
      )
      .map(input => ({
        name: input.name,
        id: input.id,
        present: true,
        valueSuppressed: true,
        disabled: input.disabled
      }));


  const csrfPresent =
    hiddenInputs.some(input =>
      /csrf/i.test(
        input.name || ""
      )
    );


  const submitControls: Array<{
    element: string;
    name: string | null;
    value: string | null;
    type: string;
    disabled: boolean;
  }> = [];


  for (const tag of inputTags) {

    const type =
      (attr(tag, "type") || "text")
        .toLowerCase();

    if (
      type !== "submit" &&
      type !== "button"
    ) {
      continue;
    }

    submitControls.push({
      element: "input",
      name: attr(tag, "name"),
      value: attr(tag, "value"),
      type,
      disabled: hasAttr(tag, "disabled")
    });
  }


  const buttonTags =
    form.match(/<button\b[^>]*>[\s\S]*?<\/button>/gi) || [];

  for (const tag of buttonTags) {

    const openingButton =
      tag.match(/<button\b[^>]*>/i)?.[0] || "";

    const type =
      (
        attr(openingButton, "type") ||
        "submit"
      ).toLowerCase();

    const buttonText =
      cleanText(tag) || null;

    submitControls.push({
      element: "button",
      name: attr(openingButton, "name"),
      value:
        attr(openingButton, "value") ||
        buttonText,
      type,
      disabled:
        hasAttr(
          openingButton,
          "disabled"
        )
    });
  }


  // Selects and textareas can also be successful form controls.
  // Return names/structure only; do not return textarea contents.
  const selectControls =
    (form.match(/<select\b[^>]*>/gi) || [])
      .map(tag => ({
        name: attr(tag, "name"),
        id: attr(tag, "id"),
        disabled: hasAttr(tag, "disabled"),
        multiple: hasAttr(tag, "multiple")
      }));


  const textareaControls =
    (form.match(/<textarea\b[^>]*>/gi) || [])
      .map(tag => ({
        name: attr(tag, "name"),
        id: attr(tag, "id"),
        disabled: hasAttr(tag, "disabled"),
        readonly: hasAttr(tag, "readonly"),
        valueSuppressed: true
      }));


  return {
    formFound: true,

    form: {
      action:
        attr(openingTag, "action"),

      method:
        (
          attr(openingTag, "method") ||
          "GET"
        ).toUpperCase(),

      id:
        attr(openingTag, "id"),

      name:
        attr(openingTag, "name"),

      enctype:
        attr(openingTag, "enctype") ||
        "application/x-www-form-urlencoded"
    },

    inputs: {
      eco:
        safeInputInfo(ecoTag),

      bus:
        safeInputInfo(busTag),

      first:
        safeInputInfo(firstTag),

      cargo:
        safeInputInfo(cargoTag)
    },

    csrfPresent,

    hiddenInputs,

    allInputs,

    selectControls,

    textareaControls,

    submitControls,

    controlCounts: {
      inputs:
        inputTags.length,
      hiddenInputs:
        hiddenInputs.length,
      selects:
        selectControls.length,
      textareas:
        textareaControls.length,
      submitControls:
        submitControls.length
    }
  };
}

/**
 * livePricesFromEditableForm()
 * Extracts the four live prices from editable form inputs.
 */
function livePricesFromEditableForm(html:string) {
  const ids = [
    "line_priceEco",
    "line_priceBus",
    "line_priceFirst",
    "line_priceCargo"
  ];

  const values =
    ids.map(id => {
      const input =
        inputById(
          html,
          id
        );

      return input
        ? parseNumber(
            input.value
          )
        : null;
    });

  if (
    values.some(
      value =>
        value === null
    )
  ) {
    return null;
  }

  return {
    eco:
      values[0] as number,

    bus:
      values[1] as number,

    first:
      values[2] as number,

    cargo:
      values[3] as number
  };
}


/**
 * livePricesFromLockedPage()
 * Extracts displayed prices when the pricing form is locked.
 */
function livePricesFromLockedPage(html:string) {
  /*
   * After a successful native price change Airlines Manager removes the
   * editable pricing form for 24 hours. The four current prices are still
   * rendered in the route information area as:
   *
   *   Current ticket price ...   (Economy)
   *   Current ticket price ...   (Business)
   *   Current ticket price ...   (First)
   *   Current price/tonne ...    (Cargo)
   *
   * Work from visible text only. This deliberately does not depend on
   * CSS classes that may change between editable and locked page states.
   */
  const text =
    cleanText(
      html
    );

  const ticketPrices:
    number[] = [];

  const ticketRegex =
    /Current\s+ticket\s+price\s*:?\s*\$?\s*([\d][\d,\s\u00a0.]*)/gi;

  let ticketMatch:
    RegExpExecArray | null;

  while (
    (
      ticketMatch =
        ticketRegex.exec(
          text
        )
    ) !== null
  ) {
    const value =
      parseNumber(
        ticketMatch[1]
      );

    if (
      value !== null
    ) {
      ticketPrices.push(
        value
      );
    }

    if (
      ticketPrices.length === 3
    ) {
      break;
    }
  }

  const cargoMatch =
    text.match(
      /Current\s+price\s*\/\s*tonne\s*:?\s*\$?\s*([\d][\d,\s\u00a0.]*)/i
    );

  const cargo =
    cargoMatch
      ? parseNumber(
          cargoMatch[1]
        )
      : null;

  if (
    ticketPrices.length !== 3 ||
    cargo === null
  ) {
    return null;
  }

  return {
    eco:
      ticketPrices[0],

    bus:
      ticketPrices[1],

    first:
      ticketPrices[2],

    cargo
  };
}


/**
 * livePrices()
 * Chooses the appropriate live-price extraction strategy for the returned page.
 */
function livePrices(html:string) {
  /*
   * Editable routes expose the native form inputs.
   * Recently changed routes expose only the locked-page price display.
   */
  return (
    livePricesFromEditableForm(
      html
    ) ??
    livePricesFromLockedPage(
      html
    )
  );
}

/**
 * pricingForm()
 * Builds the pricing form payload using supplied Economy, Business, First and Cargo prices.
 */
function pricingForm(html:string, prices:{eco:number;bus:number;first:number;cargo:number}) {
  /*
   * Scope submission fields to the actual pricing form rather than the whole
   * document. This preserves Symfony hidden fields such as line[_token]
   * without ever exposing their values outside this function.
   */
  const forms = html.match(/<form\b[\s\S]*?<\/form>/gi) || [];
  const pricingHtml =
    forms.find(formHtml => /id=["']line_priceEco["']/i.test(formHtml));

  if (!pricingHtml) {
    throw new Error("Could not find AM pricing form.");
  }

  const form = new URLSearchParams();

  for (const m of pricingHtml.matchAll(/<input\b[^>]*>/gi)) {
    const tag = m[0];
    const type = (attr(tag,"type") || "text").toLowerCase();
    const name = attr(tag,"name");

    if (
      name &&
      type === "hidden" &&
      !hasAttr(tag,"disabled")
    ) {
      form.set(name, attr(tag,"value") || "");
    }
  }

  /*
   * Airlines Manager currently uses Symfony's line[_token] hidden field.
   * Fail closed if it is absent/empty rather than attempting a write.
   */
  const formToken = form.get("line[_token]");
  if (!formToken) {
    throw new Error("AM pricing form token line[_token] is missing or empty.");
  }

  const wanted:[string,number][] = [
    ["line_priceEco",prices.eco],["line_priceBus",prices.bus],
    ["line_priceFirst",prices.first],["line_priceCargo",prices.cargo]
  ];

  for (const [id,value] of wanted) {
    const inputTag = inputTagById(pricingHtml,id);
    if (!inputTag) throw new Error(`Could not find AM pricing input ${id}`);
    const inputName = attr(inputTag,"name");
    if (!inputName) throw new Error(`AM pricing input ${id} has no name`);
    if (hasAttr(inputTag,"disabled")) throw new Error(`AM pricing input ${id} is disabled`);
    form.set(inputName,String(value));
  }

  return form;
}


/**
 * amPageLooksLocked()
 * Detects HTML indications that a pricing page is locked against changes.
 */
function amPageLooksLocked(html: string) {
  const t = cleanText(html);

  const currentLockPatterns = [
    /a\s+period\s+of\s+24\s+hours?\s+is\s+required\s+between\s+each\s+price\s+change/i,

    /remaining\s+time\s*:?\s*\d+\s*h/i,

    /(?:cannot|can't|unable to|may not)\s+(?:change|modify|update)\s+(?:the\s+)?(?:price|prices)/i,

    /(?:price|prices)\s+(?:cannot|can't)\s+be\s+(?:changed|modified|updated)/i,

    /(?:must|need to)\s+wait[^.]{0,100}before[^.]{0,100}(?:change|modify|update)/i,

    /(?:change|modify|update)[^.]{0,80}(?:available|possible)[^.]{0,80}(?:in|after)\s+\d+/i,

    /(?:locked|blocked)[^.]{0,80}(?:price|prices)/i,

    /(?:price|prices)[^.]{0,80}(?:locked|blocked)/i
  ];

  return currentLockPatterns.some(
    pattern => pattern.test(t)
  );
}



/**
 * logUpdate()
 * Inserts a price-update audit-log entry in Supabase.
 */
async function logUpdate(row:Record<string,unknown>) {
  const { data,error }=await supabase.from("am_price_updates").insert(row).select("id").single();
  if(error) throw new Error(`Could not create price-update log: ${error.message}`);
  return data.id as string;
}
/**
 * patchUpdate()
 * Updates an existing price-update audit-log entry.
 */
async function patchUpdate(id:string,row:Record<string,unknown>) {
  const { error }=await supabase.from("am_price_updates").update(row).eq("id",id);
  if(error) throw new Error(`Could not update price-update log: ${error.message}`);
}


/**
 * getLivePriceStatus()
 * Fetches current pricing information and returns status details from the live AM page.
 */
async function getLivePriceStatus(
  scanId: string,
  hubId: number,
  routeId: number
) {
  // First perform our normal stored/database checks.
  const state = await getPriceStatus(
    scanId,
    hubId,
    routeId
  );

  if (!state.route) {
    throw new Error(
      "Route is not present in this optimiser scan."
    );
  }

  // Create an authenticated Airlines Manager session.
  const { jar } =
    await createAmSession();

  const pricingUrl =
    `${AM_BASE}/marketing/pricing/${routeId}`;

  // GET only. This does NOT submit or change prices.
  const page =
    await fetchAmPage(
      jar,
      pricingUrl,
`${AM_BASE}/marketing/pricing/?airport=${hubId}&page=1`
    );

  if (!page.ok) {
    throw new Error(
      page.error ||
      `Pricing page HTTP ${page.status}`
    );
  }

  // Extract the four prices currently shown by AM.
  const prices =
    livePrices(
      page.html
    );

  if (!prices) {
    throw new Error(
      "Could not parse live Airlines Manager prices."
    );
  }

  const stored: any =
    state.route;

  const storedPrices = {
    eco:
      Number(
        stored.eco_current_price
      ),

    bus:
      Number(
        stored.bus_current_price
      ),

    first:
      Number(
        stored.first_current_price
      ),

    cargo:
      Number(
        stored.cargo_current_price
      ),
  };

  const targetPrices = {
    eco:
      Number(
        stored.eco_target_price
      ),

    bus:
      Number(
        stored.bus_target_price
      ),

    first:
      Number(
        stored.first_target_price
      ),

    cargo:
      Number(
        stored.cargo_target_price
      ),
  };

  const pricesMatchScan =
    prices.eco === storedPrices.eco &&
    prices.bus === storedPrices.bus &&
    prices.first === storedPrices.first &&
    prices.cargo === storedPrices.cargo;

  return {
    route:
      stored.route,

    routeId,

    amendable:
      state.amendable,

    affiliatedLocked:
      state.affiliatedLocked,

    databasePriceLock:
      state.priceLock,

    amPageLooksLocked:
      amPageLooksLocked(
        page.html
      ),

    livePrices:
      prices,
      
    storedPrices,

    targetPrices,

    pricesMatchScan,
  };
}

