/**
 * getPageRefreshTimes()
 * Obtains refresh timestamps used to assess the freshness of scanned pages.
 */
async function getPageRefreshTimes(
  scanId: string
) {
  const { data, error } =
    await supabase
      .from("am_scan_pages")
      .select(
        "hub_id,hub_code,mode,page_number,scanned_at"
      )
      .eq("scan_id", scanId)
      .eq("status", "complete");

  if (error) {
    throw new Error(
      `Could not load page refresh times: ${error.message}`
    );
  }

  const audit =
    new Map<string, string | null>();

  const pricing =
    new Map<string, string | null>();

  for (const row of data || []) {
    const key =
      `${row.hub_id}:${Number(row.page_number)}`;

    if (row.mode === "audit") {
      audit.set(key, row.scanned_at);
    } else if (row.mode === "pricing") {
      pricing.set(key, row.scanned_at);
    }
  }

  return { audit, pricing };
}


